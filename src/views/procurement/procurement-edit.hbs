<div class="container-fluid">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-semibold">Sửa đề nghị mua sắm</h5>
      <small class="text-muted">Cập nhật thông tin đề nghị và mặt hàng dự kiến mua</small>
    </div>

    <form action="/procurement/{{procurement.procurement_id}}/update" method="POST">
      <div class="card-body">
        <h6 class="text-primary mb-3">
          <i class="fa-solid fa-file-invoice me-1"></i> 1. Thông tin đề nghị
        </h6>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">
              Mã đề nghị <span class="text-danger">*</span>
            </label>
            <input
              type="text"
              name="procurement_code"
              class="form-control"
              value="{{procurement.procurement_code}}"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">
              Ngày đề nghị <span class="text-danger">*</span>
            </label>
            <input
              type="date"
              name="request_date"
              class="form-control"
              value="{{procurement.request_date}}"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">
              Phòng ban <span class="text-danger">*</span>
            </label>
            <select name="department_id" class="form-select" required>
              <option value="">-- Chọn phòng ban --</option>
              {{#each departments}}
                <option
                  value="{{this.department_id}}"
                  {{#if (eq this.department_id ../procurement.department_id)}}selected{{/if}}
                >
                  {{this.department_name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Người đề nghị</label>
            <select name="requester_id" class="form-select">
              <option value="">-- Chọn người đề nghị --</option>
              {{#each employees}}
                <option
                  value="{{this.employee_id}}"
                  {{#if (eq this.employee_id ../procurement.requester_id)}}selected{{/if}}
                >
                  {{this.full_name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Trạng thái</label>
            <select name="status" class="form-select">
              <option value="pending" {{#if (eq procurement.status "pending")}}selected{{/if}}>
                Chờ duyệt
              </option>
              <option value="approved" {{#if (eq procurement.status "approved")}}selected{{/if}}>
                Đã duyệt
              </option>
              <option value="received" {{#if (eq procurement.status "received")}}selected{{/if}}>
                Đã nhập kho
              </option>
              <option value="rejected" {{#if (eq procurement.status "rejected")}}selected{{/if}}>
                Từ chối
              </option>
            </select>
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Lý do mua sắm</label>
            <textarea
              name="reason"
              class="form-control"
              rows="2"
            >{{procurement.reason}}</textarea>
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Ghi chú</label>
            <textarea
              name="note"
              class="form-control"
              rows="2"
            >{{procurement.note}}</textarea>
          </div>
        </div>

        <hr />

        <h6 class="text-primary mb-3">
          <i class="fa-solid fa-box-open me-1"></i> 2. Thông tin tài sản cần mua
        </h6>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">
              Tên tài sản <span class="text-danger">*</span>
            </label>
            <input
              type="text"
              name="asset_name"
              class="form-control"
              value="{{detail.asset_name}}"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">
              Danh mục tài sản <span class="text-danger">*</span>
            </label>
            <select name="category_id" class="form-select" required>
              <option value="">-- Chọn danh mục --</option>
              {{#each categories}}
                <option
                  value="{{this.category_id}}"
                  {{#if (eq this.category_id ../detail.category_id)}}selected{{/if}}
                >
                  {{this.category_name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">
              Số lượng <span class="text-danger">*</span>
            </label>
            <input
              type="number"
              name="quantity"
              class="form-control"
              min="1"
              value="{{detail.quantity}}"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Đơn giá dự kiến (VNĐ)</label>
            <input
              type="number"
              name="estimated_cost"
              class="form-control"
              min="0"
              step="1"
              value="{{detail.estimated_cost}}"
            />
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Mô tả tài sản / Cấu hình</label>
            <textarea
              name="description"
              class="form-control"
              rows="2"
            >{{detail.description}}</textarea>
          </div>
        </div>
      </div>

      <div class="card-footer bg-white border-top d-flex justify-content-end gap-2 py-3">
        <a href="/procurement" class="btn btn-secondary">
          Hủy
        </a>
        <button type="submit" class="btn btn-primary">
          Lưu thay đổi
        </button>
      </div>
    </form>
  </div>
</div>
