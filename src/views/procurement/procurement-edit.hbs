<div class="container-fluid">
  <div class="mb-4">
    <h3 class="mb-1">Sửa đề nghị mua sắm</h3>
    <p class="text-secondary mb-0">Cập nhật thông tin đề nghị và mặt hàng dự kiến mua</p>
  </div>

  <div class="card">
    <form action="/procurement/{{procurement.procurement_id}}/update" method="POST">
      <div class="card-body">
        <h6 class="mb-3">1. Thông tin đề nghị</h6>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">
              Mã đề nghị <span class="text-danger">*</span>
            </label>
            <input
              type="text"
              name="procurement_code"
              class="form-control"
              value="{{procurement.procurement_code}}"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">
              Ngày đề nghị <span class="text-danger">*</span>
            </label>
            <input
              type="date"
              name="request_date"
              class="form-control"
              value="{{procurement.request_date}}"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">
              Phòng ban <span class="text-danger">*</span>
            </label>
            <select name="department_id" class="form-select" required>
              <option value="">-- Chọn phòng ban --</option>
              {{#each departments}}
                <option
                  value="{{this.department_id}}"
                  {{#if (eq this.department_id ../procurement.department_id)}}selected{{/if}}
                >
                  {{this.department_name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Người đề nghị</label>
            <select name="requester_id" class="form-select">
              <option value="">-- Chọn người đề nghị --</option>
              {{#each employees}}
                <option
                  value="{{this.employee_id}}"
                  {{#if (eq this.employee_id ../procurement.requester_id)}}selected{{/if}}
                >
                  {{this.full_name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Trạng thái</label>
            <select name="status" class="form-select">
              <option value="pending_manager" {{#if (eq procurement.status "pending_manager")}}selected{{/if}}>
                Chờ Quản lý duyệt
              </option>
              <option value="pending_director" {{#if (eq procurement.status "pending_director")}}selected{{/if}}>
                Chờ Giám đốc duyệt
              </option>
              <option value="approved" {{#if (eq procurement.status "approved")}}selected{{/if}}>
                Đã duyệt
              </option>
              <option value="completed" {{#if (eq procurement.status "completed")}}selected{{/if}}>
                Hoàn thành
              </option>
              <option value="rejected" {{#if (eq procurement.status "rejected")}}selected{{/if}}>
                Từ chối
              </option>
            </select>
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Lý do mua sắm</label>
            <textarea
              name="reason"
              class="form-control"
              rows="2"
            >{{procurement.reason}}</textarea>
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Ghi chú</label>
            <textarea
              name="note"
              class="form-control"
              rows="2"
            >{{procurement.note}}</textarea>
          </div>
        </div>

        <hr />

        <h6 class="mb-3">2. Thông tin tài sản cần mua</h6>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">
              Tên tài sản <span class="text-danger">*</span>
            </label>
            <input
              type="text"
              name="asset_name"
              class="form-control"
              value="{{detail.asset_name}}"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">
              Danh mục tài sản <span class="text-danger">*</span>
            </label>
            <select name="category_id" class="form-select" required>
              <option value="">-- Chọn danh mục --</option>
              {{#each categories}}
                <option
                  value="{{this.category_id}}"
                  {{#if (eq this.category_id ../detail.category_id)}}selected{{/if}}
                >
                  {{this.category_name}}
                </option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">
              Số lượng <span class="text-danger">*</span>
            </label>
            <input
              type="number"
              name="quantity"
              class="form-control"
              min="1"
              value="{{detail.quantity}}"
              required
            />
          </div>

          <div class="col-md-6 mb-3">
            <label class="form-label">Đơn giá dự kiến (VNĐ)</label>
            <input
              type="number"
              name="estimated_cost"
              class="form-control"
              min="0"
              step="1"
              value="{{detail.estimated_cost}}"
            />
          </div>

          <div class="col-12 mb-3">
            <label class="form-label">Mô tả tài sản / Cấu hình</label>
            <textarea
              name="description"
              class="form-control"
              rows="2"
            >{{detail.description}}</textarea>
          </div>
        </div>
      </div>

      <div class="card-footer bg-light border-top d-flex gap-2 py-3">
        <a href="/procurement" class="btn btn-secondary">Hủy</a>
        <button type="submit" class="btn btn-secondary">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>
