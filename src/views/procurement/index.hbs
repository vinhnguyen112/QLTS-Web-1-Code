<div class="container-fluid">
  <div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col">
          <h5 class="mb-0 fw-semibold">Mua sắm tài sản</h5>
          <small class="text-muted">
            Quản lý danh sách đề nghị mua sắm tài sản
          </small>
        </div>

        <div class="col-auto d-flex align-items-center gap-2">
          <form action="/procurement" method="GET" class="m-0">
            <div class="input-group">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm mã đề nghị..."
              />

              <button class="btn btn-secondary" type="submit">
                <i class="fa-solid fa-magnifying-glass me-1"></i> Tìm
              </button>
            </div>
          </form>

          <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#createProcurementModal"
          >
            <i class="fa-solid fa-plus me-1"></i> Tạo đề nghị
          </button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>STT</th>
            <th>Mã đề nghị</th>
            <th>Ngày đề nghị</th>
            <th>Người đề nghị</th>
            <th>Phòng ban</th>
            <th>Lý do</th>
            <th>Trạng thái</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>

        <tbody>
          {{#each procurements}}
            <tr>
              <td>{{addOne @index}}</td>
              <td class="fw-medium text-primary">{{this.procurement_code}}</td>
              <td>{{formatDate this.request_date}}</td>
              <td>{{#if this.requester_name}}{{this.requester_name}}{{else}}<span class="text-muted">-</span>{{/if}}</td>
              <td>{{#if this.department_name}}{{this.department_name}}{{else}}<span class="text-muted">-</span>{{/if}}</td>
              <td>{{#if this.reason}}{{this.reason}}{{else}}<span class="text-muted">-</span>{{/if}}</td>
              <td>
                {{#if (eq this.status "pending")}}
                  <span class="badge bg-warning text-dark">Chờ duyệt</span>
                {{else if (eq this.status "approved")}}
                  <span class="badge bg-success">Đã duyệt</span>
                {{else if (eq this.status "received")}}
                  <span class="badge bg-info">Đã nhập kho</span>
                {{else if (eq this.status "rejected")}}
                  <span class="badge bg-danger">Từ chối</span>
                {{else}}
                  <span class="badge bg-secondary">{{this.status}}</span>
                {{/if}}
              </td>
              <td>
                <div class="d-flex justify-content-center gap-1">
                  <a
                    href="/procurement/{{this.procurement_id}}"
                    class="btn btn-sm btn-info text-white"
                  >
                    Xem
                  </a>

                  <a
                    href="/procurement/{{this.procurement_id}}/edit"
                    class="btn btn-sm btn-warning"
                  >
                    Sửa
                  </a>

                  <form
                    action="/procurement/{{this.procurement_id}}/delete"
                    method="POST"
                    class="m-0"
                    onsubmit="return confirm('Bạn có chắc chắn muốn xóa đề nghị mua sắm này không?');"
                  >
                    <button type="submit" class="btn btn-sm btn-danger">
                      Xóa
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center text-muted py-4">
                Chưa có đề nghị mua sắm nào.
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

  </div>
</div>

<div
  class="modal fade"
  id="createProcurementModal"
  tabindex="-1"
  aria-labelledby="createProcurementModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    {{> procurement-create}}
  </div>
</div>

{{#if pages.length}}
  <nav class="mt-3">
    <ul class="pagination">
      {{#each pages}}
        <li class="page-item {{#if active}}active{{/if}}">
          <a
            class="page-link"
            href="/procurement?page={{number}}&name={{../searchName}}"
          >
            {{number}}
          </a>
        </li>
      {{/each}}
    </ul>
  </nav>
{{/if}}