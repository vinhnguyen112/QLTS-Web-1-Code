<div class="container-fluid">
  <div class="mb-4">
    <h3 class="mb-1">Chi tiết đề nghị mua sắm</h3>
    <p class="text-secondary mb-0">
      Xem thông tin đề nghị và danh sách tài sản yêu cầu mua sắm
    </p>
  </div>

  <div class="d-flex gap-2 mb-3">
    <a href="/procurement" class="btn btn-secondary">
      <i class="fa-solid fa-arrow-left me-1"></i> Quay lại
    </a>
    <a
      href="/procurement/{{procurement.procurement_id}}/edit"
      class="btn btn-warning"
    >
      <i class="fa-solid fa-pen-to-square me-1"></i> Chỉnh sửa
    </a>
    <form
      action="/procurement/{{procurement.procurement_id}}/delete"
      method="POST"
      style="display: inline;"
      onsubmit="return confirm('Bạn có chắc chắn muốn xóa đề nghị mua sắm này không?');"
    >
      <button type="submit" class="btn btn-danger">
        <i class="fa-solid fa-trash me-1"></i> Xóa
      </button>
    </form>
  </div>

  <!-- Thông tin đề nghị -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-semibold">1. Thông tin chung</h5>
    </div>
    <div class="card-body">
      <div class="row">
        <div class="col-md-6 mb-3">
          <strong>Mã đề nghị:</strong>
          <div class="text-primary fw-medium">{{procurement.procurement_code}}</div>
        </div>
        <div class="col-md-6 mb-3">
          <strong>Ngày đề nghị:</strong>
          <div>{{formatDate procurement.request_date}}</div>
        </div>
        <div class="col-md-6 mb-3">
          <strong>Người đề nghị:</strong>
          <div>{{#if procurement.requester_name}}{{procurement.requester_name}}{{else}}<span class="text-muted">(Chưa chọn)</span>{{/if}}</div>
        </div>
        <div class="col-md-6 mb-3">
          <strong>Phòng ban:</strong>
          <div>{{#if procurement.department_name}}{{procurement.department_name}}{{else}}<span class="text-muted">(Chưa chọn)</span>{{/if}}</div>
        </div>
        <div class="col-md-6 mb-3">
          <strong>Trạng thái:</strong>
          <div>
            {{#if (eq procurement.status "pending")}}
              <span class="badge bg-warning text-dark">Chờ duyệt</span>
            {{else if (eq procurement.status "approved")}}
              <span class="badge bg-success">Đã duyệt</span>
            {{else if (eq procurement.status "received")}}
              <span class="badge bg-info">Đã nhập kho</span>
            {{else if (eq procurement.status "rejected")}}
              <span class="badge bg-danger">Từ chối</span>
            {{else}}
              <span class="badge bg-secondary">{{procurement.status}}</span>
            {{/if}}
          </div>
        </div>
        <div class="col-md-6 mb-3">
          <strong>Lý do mua sắm:</strong>
          <div>{{#if procurement.reason}}{{procurement.reason}}{{else}}<span class="text-muted">(Không có)</span>{{/if}}</div>
        </div>
        {{#if procurement.reject_reason}}
          <div class="col-md-6 mb-3">
            <strong class="text-danger">Lý do từ chối:</strong>
            <div class="text-danger">{{procurement.reject_reason}}</div>
          </div>
        {{/if}}
        <div class="col-12 mb-3">
          <strong>Ghi chú:</strong>
          <div>{{#if procurement.note}}{{procurement.note}}{{else}}<span class="text-muted">(Không có ghi chú)</span>{{/if}}</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Danh sách tài sản đề nghị mua -->
  <div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-semibold">2. Danh sách tài sản đề nghị mua</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 60px;">STT</th>
            <th>Tên tài sản</th>
            <th>Danh mục</th>
            <th class="text-center">Số lượng</th>
            <th class="text-end">Đơn giá dự kiến</th>
            <th class="text-end">Thành tiền</th>
            <th>Mô tả / Cấu hình</th>
          </tr>
        </thead>
        <tbody>
          {{#each details}}
            <tr>
              <td>{{addOne @index}}</td>
              <td class="fw-medium">{{this.asset_name}}</td>
              <td>{{#if this.category_name}}{{this.category_name}}{{else}}<span class="text-muted">(Chưa chọn)</span>{{/if}}</td>
              <td class="text-center">{{this.quantity}}</td>
              <td class="text-end">{{formatCurrency this.estimated_cost}} VNĐ</td>
              <td class="text-end fw-semibold">{{formatCurrency this.lineTotal}} VNĐ</td>
              <td>{{#if this.description}}{{this.description}}{{else}}<span class="text-muted">-</span>{{/if}}</td>
            </tr>
          {{else}}
            <tr>
              <td colspan="7" class="text-center text-muted py-3">
                Chưa có mặt hàng nào trong đề nghị này.
              </td>
            </tr>
          {{/each}}
        </tbody>
        <tfoot>
          <tr class="table-light">
            <th colspan="5" class="text-end">Tổng tiền dự kiến:</th>
            <th class="text-end text-danger fw-bold fs-6">
              {{formatCurrency totalCost}} VNĐ
            </th>
            <th></th>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
</div>