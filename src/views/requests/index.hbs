<div class="container-fluid p-0">
  <div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 fw-bold text-dark">Phiếu đề xuất & Phê duyệt</h5>
        <small class="text-muted">Quản lý các đề xuất mua sắm và cấp phát tài sản</small>
      </div>
      <a href="/requests/create" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Lập đề xuất mới
      </a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3">#</th>
            <th scope="col">Mã phiếu</th>
            <th scope="col">Loại đề xuất</th>
            <th scope="col">Tiêu đề</th>
            <th scope="col">Người lập</th>
            <th scope="col">Ngày tạo</th>
            <th scope="col">Trạng thái</th>
            <th scope="col" class="text-end pe-3">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each requests}}
            <tr>
              <td class="ps-3 text-muted">{{addOne @index}}</td>
              <td class="fw-semibold text-dark">{{this.code}}</td>
              <td>{{{requestTypeBadge this.type}}}</td>
              <td class="fw-semibold text-dark">{{this.title}}</td>
              <td>{{this.requester_name}}</td>
              <td class="text-muted small">{{formatDate this.created_at}}</td>
              <td>{{{requestStatusBadge this.status}}}</td>
              <td class="text-end pe-3">
                <a href="/requests/{{this.id}}" class="btn btn-primary btn-sm">Chi tiết</a>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center py-4 text-muted">Chưa có phiếu đề xuất nào</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
