<div class="container-fluid p-0" style="max-width: 700px; margin: auto;">
  <div class="card border shadow-none">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 fw-bold text-dark">Sửa nhà cung cấp: {{supplier.name}}</h5>
        <small class="text-muted">{{supplier.code}}</small>
      </div>
      <a href="/suppliers" class="btn btn-secondary btn-sm">Quay lại</a>
    </div>

    <form action="/suppliers/{{supplier.id}}/update" method="POST">
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Tên công ty / Đối tác <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="name" value="{{supplier.name}}" required />
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Mã đối tác</label>
          <input type="text" class="form-control" name="code" value="{{supplier.code}}" />
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Mã số thuế</label>
          <input type="text" class="form-control" name="tax_code" value="{{supplier.tax_code}}" />
        </div>

        <div class="row g-2 mb-3">
          <div class="col-md-6">
            <label class="form-label small fw-semibold">Số điện thoại</label>
            <input type="text" class="form-control" name="phone" value="{{supplier.phone}}" />
          </div>
          <div class="col-md-6">
            <label class="form-label small fw-semibold">Email liên hệ</label>
            <input type="email" class="form-control" name="email" value="{{supplier.email}}" />
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold">Địa chỉ trụ sở</label>
          <textarea class="form-control" name="address" rows="2">{{supplier.address}}</textarea>
        </div>
      </div>

      <div class="card-footer bg-white border-top d-flex justify-content-end gap-2 py-3">
        <a href="/suppliers" class="btn btn-secondary btn-sm px-3">Hủy</a>
        <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>
