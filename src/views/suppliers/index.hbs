<div class="container-fluid p-0">
  <div class="card">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-6">
          <h5 class="mb-0 fw-bold text-dark">Nhà cung cấp & Đối tác thiết bị</h5>
          <small class="text-muted">Danh bạ các công ty cung cấp máy móc, thiết bị và dịch vụ bảo hành</small>
        </div>

        <div class="col-md-6 d-flex flex-wrap justify-content-md-end align-items-center gap-2">
          <form action="/suppliers" method="get" class="m-0" role="search">
            <div class="input-group input-group-sm" style="width: 220px;">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm tên, MST, mã..."
              />
              <button class="btn btn-primary" type="submit">Tìm</button>
            </div>
          </form>
          <button
            type="button"
            class="btn btn-sm btn-success"
            data-bs-toggle="modal"
            data-bs-target="#addSupplierModal"
          >
            Thêm đối tác mới
          </button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3 text-nowrap">#</th>
            <th scope="col">Tên nhà cung cấp</th>
            <th scope="col">Mã số thuế</th>
            <th scope="col">Số điện thoại</th>
            <th scope="col">Email</th>
            <th scope="col">Địa chỉ</th>
            <th scope="col">Tài sản cung cấp</th>
            <th scope="col" class="text-end pe-3 text-nowrap">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each suppliers}}
            <tr>
              <th scope="row" class="ps-3 text-muted">{{addOne @index}}</th>
              <td>
                <div class="fw-semibold text-dark">{{this.name}}</div>
                <small class="text-muted font-monospace">{{this.code}}</small>
              </td>
              <td>{{this.tax_code}}</td>
              <td>{{this.phone}}</td>
              <td>{{this.email}}</td>
              <td class="text-secondary small">{{this.address}}</td>
              <td><span class="badge text-bg-light border">{{this.asset_count}} tài sản</span></td>
              <td class="text-end pe-3 text-nowrap">
                <div class="d-inline-flex gap-1">
                  <a href="/suppliers/{{this.id}}/edit" class="btn btn-warning">Sửa</a>
                  <form
                    action="/suppliers/{{this.id}}/delete"
                    method="POST"
                    class="d-inline m-0"
                    data-confirm="Bạn có chắc chắn muốn ngưng hợp tác với nhà cung cấp này?"
                  >
                    <button type="submit" class="btn btn-danger">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center py-4 text-muted">Chưa có nhà cung cấp nào.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Phân trang -->
    {{#if (gt totalPages 1)}}
    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
      <small class="text-muted">Trang {{pages.[0].number}} / {{totalPages}}</small>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          {{#each pages}}
            <li class="page-item {{#if this.active}}active{{/if}}">
              <a class="page-link" href="/suppliers?page={{this.number}}&name={{../searchName}}">
                {{this.number}}
              </a>
            </li>
          {{/each}}
        </ul>
      </nav>
    </div>
    {{/if}}
  </div>
</div>

<!-- Modal Thêm Nhà Cung Cấp -->
<div class="modal fade" id="addSupplierModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/suppliers" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fw-bold text-dark">Thêm nhà cung cấp mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Tên công ty / Đối tác <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" placeholder="Ví dụ: Công ty TNHH Phân Phối FPT Synnex" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Mã đối tác</label>
            <input type="text" class="form-control" name="code" placeholder="Ví dụ: NCC-FPT, NCC-PHONGVU" />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Mã số thuế</label>
            <input type="text" class="form-control" name="tax_code" placeholder="Mã số thuế doanh nghiệp" />
          </div>

          <div class="row g-2 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Số điện thoại</label>
              <input type="text" class="form-control" name="phone" placeholder="024 xxxx xxxx" />
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Email liên hệ</label>
              <input type="email" class="form-control" name="email" placeholder="contact@supplier.vn" />
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Địa chỉ trụ sở</label>
            <textarea class="form-control" name="address" rows="2" placeholder="Địa chỉ đối tác..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-success btn-sm px-3">
            Lưu đối tác
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
