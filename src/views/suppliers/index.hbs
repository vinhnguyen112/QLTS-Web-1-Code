<div class="container-fluid">
  <div class="card">
    <div class="card-header">
      <div class="row align-items-center g-2">
        <div class="col">
          <h5 class="mb-0">Nhà cung cấp & Đối tác bảo hành</h5>
          <small class="text-muted">Quản lý các đối tác cung cấp thiết bị và bảo trì</small>
        </div>

        <div class="col-auto d-flex align-items-center gap-2">
          <form action="/suppliers" method="get" class="m-0" role="search">
            <div class="input-group">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm nhà cung cấp, MST..."
              />
              <button class="btn btn-secondary" type="submit">Lọc</button>
            </div>
          </form>
          <button
            type="button"
            class="btn btn-sm btn-secondary"
            data-bs-toggle="modal"
            data-bs-target="#addSupplierModal"
          >+ Thêm nhà cung cấp</button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">STT</th>
            <th>Tên nhà cung cấp</th>
            <th>Mã số thuế</th>
            <th>Điện thoại</th>
            <th>Email</th>
            <th>Địa chỉ</th>
            <th class="text-center" style="width: 140px;">Tài sản cung cấp</th>
            <th class="text-center" style="width: 140px;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each suppliers}}
            <tr>
              <td class="text-center">{{addOne @index}}</td>
              <td><strong>{{this.supplier_name}}</strong></td>
              <td>{{#if this.tax_code}}<span class="badge bg-light text-dark border">{{this.tax_code}}</span>{{else}}-{{/if}}</td>
              <td>{{#if this.contact_phone}}{{this.contact_phone}}{{else}}-{{/if}}</td>
              <td>{{#if this.contact_email}}<a href="mailto:{{this.contact_email}}">{{this.contact_email}}</a>{{else}}-{{/if}}</td>
              <td><small class="text-muted">{{#if this.address}}{{this.address}}{{else}}-{{/if}}</small></td>
              <td class="text-center"><span class="badge bg-light text-dark border">{{this.asset_count}} tài sản</span></td>
              <td>
                <div class="d-flex justify-content-center gap-1">
                  <a href="/suppliers/{{this.supplier_id}}/edit" class="btn btn-sm btn-warning">Sửa</a>
                  <form
                    action="/suppliers/{{this.supplier_id}}/delete"
                    method="POST"
                    class="m-0"
                    onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhà cung cấp này không?');"
                  >
                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center py-4 text-muted">Chưa có nhà cung cấp nào.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Thêm Nhà cung cấp -->
<div class="modal fade" id="addSupplierModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/suppliers" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Thêm nhà cung cấp mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Tên nhà cung cấp <span class="text-danger">*</span></label>
            <input type="text" name="supplier_name" class="form-control" placeholder="Ví dụ: Công ty TNHH Tin Học Phong Vũ" required />
          </div>
          <div class="mb-3">
            <label class="form-label">Mã số thuế</label>
            <input type="text" name="tax_code" class="form-control" placeholder="Ví dụ: 0309876543" />
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Điện thoại liên hệ</label>
              <input type="text" name="contact_phone" class="form-control" placeholder="Ví dụ: 18006867" />
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Email</label>
              <input type="email" name="contact_email" class="form-control" placeholder="contact@example.com" />
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Địa chỉ</label>
            <textarea name="address" class="form-control" rows="2" placeholder="Địa chỉ trụ sở / văn phòng"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-secondary">Lưu nhà cung cấp</button>
        </div>
      </form>
    </div>
  </div>
</div>

{{#if pages.length}}
  <nav class="mt-3">
    <ul class="pagination">
      {{#each pages}}
        <li class="page-item {{#if active}}active{{/if}}">
          <a class="page-link" href="/suppliers?page={{number}}&name={{../searchName}}">{{number}}</a>
        </li>
      {{/each}}
    </ul>
  </nav>
{{/if}}
