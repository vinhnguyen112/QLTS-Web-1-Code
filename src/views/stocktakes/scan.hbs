<div class="container-fluid p-0" style="max-width: 650px; margin: auto;">
  <div class="card border shadow-none mb-3">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 fw-bold text-dark">Quét mã QR kiểm kê</h5>
        <small class="text-muted">Đợt: <b>{{stocktake.code}}</b> - {{stocktake.name}}</small>
      </div>
      <a href="/stocktakes/{{stocktake.id}}" class="btn btn-secondary btn-sm">
        Bảng kết quả
      </a>
    </div>

    <div class="card-body pt-0 text-center">
      <!-- Vùng hiển thị Camera -->
      <div id="reader" class="rounded overflow-hidden border mb-3 bg-dark" style="min-height: 280px;"></div>

      <!-- Thông báo kết quả quét -->
      <div id="scanResultAlert" class="alert d-none py-2 px-3 small fw-bold mb-3" role="alert"></div>

      <!-- Nhập mã bằng tay nếu không có camera -->
      <div class="p-3 bg-light rounded border text-start">
        <label class="form-label small fw-semibold text-secondary">Hoặc nhập mã tài sản thủ công:</label>
        <div class="input-group">
          <input type="text" id="manualCodeInput" class="form-control" placeholder="Nhập mã ví dụ: TS-2026-00001" onkeydown="if(event.key === 'Enter') submitManualCode()" />
          <button class="btn btn-primary" type="button" onclick="submitManualCode()">
            Ghi nhận
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Thư viện quét mã QR qua Camera -->
<script src="https://unpkg.com/html5-qrcode"></script>
<script>
  const stocktakeId = {{stocktake.id}};
  let isProcessing = false;

  function showMessage(type, text) {
    const alertBox = document.getElementById('scanResultAlert');
    alertBox.className = `alert alert-${type} py-2 px-3 small fw-bold mb-3`;
    alertBox.innerHTML = text;
    alertBox.classList.remove('d-none');
  }

  async function processCode(code) {
    if (isProcessing) return;
    isProcessing = true;

    try {
      showMessage('info', `Đang xử lý mã: <b>${code}</b>...`);

      const res = await fetch(`/stocktakes/${stocktakeId}/record-scan`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ code: code.trim() })
      });

      const data = await res.json();

      if (data.success) {
        if (data.status === 'matched') {
          showMessage('success', `${data.message}`);
        } else {
          showMessage('warning', `${data.message}`);
        }
      } else {
        showMessage('danger', `${data.message}`);
      }
    } catch (err) {
      showMessage('danger', 'Lỗi kết nối máy chủ: ' + err.message);
    } finally {
      setTimeout(() => { isProcessing = false; }, 2000);
    }
  }

  function submitManualCode() {
    const input = document.getElementById('manualCodeInput');
    const val = input.value.trim();
    if (!val) return alert('Vui lòng nhập mã tài sản');
    processCode(val);
    input.value = '';
  }

  // Khởi động Camera quét QR
  const html5QrCode = new Html5Qrcode("reader");
  const config = { fps: 10, qrbox: { width: 220, height: 220 } };

  html5QrCode.start(
    { facingMode: "environment" }, // Ưu tiên camera sau trên điện thoại
    config,
    (decodedText) => {
      processCode(decodedText);
    },
    (errorMessage) => {
      // Bỏ qua lỗi nhận diện từng frame
    }
  ).catch(err => {
    document.getElementById('reader').innerHTML = `
      <div class="p-4 text-white text-center">
        <div class="small">Không thể mở camera (thiếu quyền truy cập hoặc thiết bị không hỗ trợ).</div>
        <div class="text-muted small mt-1">Bạn có thể sử dụng ô nhập mã thủ công ở bên dưới!</div>
      </div>
    `;
  });
</script>

