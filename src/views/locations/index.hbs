<div class="container-fluid p-0">
  <div class="card">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-6">
          <h5 class="mb-0 fw-bold text-dark">Vị trí phòng máy & Kho</h5>
          <small class="text-muted">Quản lý sơ đồ phòng học, phòng ban và kho lưu trữ thiết bị</small>
        </div>

        <div class="col-md-6 d-flex flex-wrap justify-content-md-end align-items-center gap-2">
          <form action="/locations" method="get" class="m-0" role="search">
            <div class="input-group input-group-sm" style="width: 220px;">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm mã hoặc tên phòng..."
              />
              <button class="btn btn-primary" type="submit">Tìm</button>
            </div>
          </form>
          <button
            type="button"
            class="btn btn-sm btn-success"
            data-bs-toggle="modal"
            data-bs-target="#addLocationModal"
          >
            Thêm vị trí mới
          </button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3 text-nowrap">#</th>
            <th scope="col" class="text-nowrap">Mã vị trí</th>
            <th scope="col">Tên phòng / Khu vực</th>
            <th scope="col">Thuộc đơn vị</th>
            <th scope="col">Số tài sản đang đặt tại đây</th>
            <th scope="col" class="text-end pe-3 text-nowrap">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each locations}}
            <tr>
              <th scope="row" class="ps-3 text-muted">{{addOne @index}}</th>
              <td class="fw-bold text-dark">{{this.code}}</td>
              <td class="text-dark">{{this.name}}</td>
              <td>{{this.org_unit_name}}</td>
              <td>
                {{#if this.asset_count}}
                  <span class="badge text-bg-light border">{{this.asset_count}} tài sản</span>
                {{else}}
                  <span class="text-muted small">0</span>
                {{/if}}
              </td>
              <td class="text-end pe-3">
                <div class="btn-group" role="group" aria-label="Basic mixed styles example">
                  <form
                    action="/locations/{{this.id}}/delete"
                    method="POST"
                    class="d-inline m-0"
                    onsubmit="return confirm('Bạn có chắc chắn muốn ngưng hoạt động vị trí này?');"
                  >
                    <button type="submit" class="btn btn-danger">
                      Xóa
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy vị trí nào.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Phân trang -->
    {{#if (gt totalPages 1)}}
    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
      <small class="text-muted">Trang {{pages.[0].number}} / {{totalPages}}</small>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          {{#each pages}}
            <li class="page-item {{#if this.active}}active{{/if}}">
              <a class="page-link" href="/locations?page={{this.number}}&name={{../searchName}}">
                {{this.number}}
              </a>
            </li>
          {{/each}}
        </ul>
      </nav>
    </div>
    {{/if}}
  </div>
</div>

<!-- Modal Thêm Vị Trí Mới -->
<div class="modal fade" id="addLocationModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/locations" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fw-bold text-dark">Thêm vị trí / Phòng máy</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Mã vị trí / Mã phòng <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="code" placeholder="Ví dụ: P601, KHO-T1, LAB-02" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Tên phòng / Khu vực <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" placeholder="Ví dụ: Phòng Thực hành Máy tính 601 (Tầng 6)" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Đơn vị quản lý khu vực này</label>
            <select class="form-select" name="org_unit_id">
              {{#each orgUnits}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-success btn-sm px-3">
            Lưu vị trí
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
