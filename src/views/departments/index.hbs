<div class="container-fluid">
  <div class="card">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col">
          <h5 class="mb-0">Phòng ban</h5>
          <small class="text-muted">Quản lý các phòng ban trong hệ thống</small>
        </div>

        <div class="col-auto d-flex align-items-center gap-2">
          <form action="" method="get" class="m-0" role="search">
            <div class="input-group">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm phòng ban..."
              />
              <button class="btn btn-secondary" type="submit">Lọc</button>
            </div>
          </form>
          <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addDepartmentModal"
          >Thêm phòng ban</button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>STT</th>
            <th>Mã phòng ban</th>
            <th>Tên phòng ban</th>
            <th>Số nhân sự</th>
            <th>Mô tả</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each departments}}
            <tr>
              <td>{{addOne @index}}</td>
              <td>{{this.department_code}}</td>
              <td>{{this.department_name}}</td>
              <td>{{this.employee_count}}</td>
              <td>{{this.description}}</td>
              <td>
                <div class="d-flex justify-content-center gap-1">
                  <a href="/departments/{{this.department_id}}" class="btn btn-sm btn-info">Xem</a>
                  <a href="/departments/{{this.department_id}}/edit" class="btn btn-sm btn-warning">Sửa</a>
                  <form
                    action="/departments/{{this.department_id}}/delete"
                    method="POST"
                    class="m-0"
                    onsubmit="return confirm('Bạn có chắc chắn muốn xóa phòng ban này không?');"
                  >
                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

  </div>
</div>

<!-- Modal thêm phòng ban -->
<div class="modal fade" id="addDepartmentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      {{> departments-create}}
    </div>
  </div>
</div>