<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Phòng ban</h3>
            <p class="text-secondary mb-0">
                Quản lý các phòng ban trong hệ thống
            </p>
        </div>

        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addDepartmentModal">
            + Thêm phòng ban
        </button>
    </div>


    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label">
                        Tìm kiếm
                    </label>

                    <input type="text"
                           class="form-control"
                           placeholder="Mã phòng ban hoặc tên phòng ban...">
                </div>

                <div class="col-md-4">
                    <label class="form-label">
                        Phòng ban
                    </label>
                    <select class="form-select">
                        <option selected>
                            Tất cả phòng ban
                        </option>
                        <option>
                            Phòng Công nghệ thông tin
                        </option>
                        <option>
                            Phòng Kế toán
                        </option>
                        <option>
                            Phòng Nhân sự
                        </option>
                        <option>
                            Phòng Hành chính
                        </option>
                    </select>
                </div>


                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-secondary w-100">
                        Lọc
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            Danh sách phòng ban
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Mã phòng ban</th>
                        <th>Tên phòng ban</th>
                        <th>Số nhân sự</th>
                        <th>Mô tả</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    {{#each departments}}
                        <tr>
                            <td>{{@index}}</td>
                            <td>{{this.department_code}}</td>
                            <td>{{this.department_name}}</td>
                            <td>{{employee_count}}</td>
                            <td>{{this.description}}</td>
                            <td>
                                <a href="/departments/{{department_id}}/edit" class="btn btn-sm btn-warning"> Sửa</a>
                                <form action="/departments/{{department_id}}/delete" method="POST" class="d-inline"  onsubmit="return confirm('Bạn có chắc muốn xóa phòng ban này không?')">
                                    <button type="submit" class="btn btn-sm btn-danger"> Xóa </button>
                                </form>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal thêm phòng ban -->
<div class="modal fade"
     id="addDepartmentModal"
     tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            {{> departments-create}}
        </div>
    </div>
</div>