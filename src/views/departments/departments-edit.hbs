<div class="container-fluid p-0" style="max-width: 700px; margin: auto;">
  <div class="card border shadow-none">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 fw-bold text-dark">Sửa phòng ban: {{department.name}}</h5>
        <small class="text-muted">Mã: {{department.code}}</small>
      </div>
      <a href="/departments" class="btn btn-secondary btn-sm">Quay lại</a>
    </div>

    <form action="/departments/{{department.id}}/update" method="POST">
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Mã phòng ban <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="code" value="{{department.code}}" required />
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Tên phòng ban <span class="text-danger">*</span></label>
          <input type="text" class="form-control" name="name" value="{{department.name}}" required />
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold">Loại hình</label>
          <select class="form-select" name="type">
            <option value="DEPARTMENT" {{#if (eq department.type "DEPARTMENT")}}selected{{/if}}>Phòng ban</option>
            <option value="BRANCH" {{#if (eq department.type "BRANCH")}}selected{{/if}}>Trụ sở / Chi nhánh</option>
          </select>
        </div>
      </div>

      <div class="card-footer bg-white border-top d-flex justify-content-end gap-2 py-3">
        <a href="/departments" class="btn btn-secondary btn-sm px-3">Hủy</a>
        <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>
