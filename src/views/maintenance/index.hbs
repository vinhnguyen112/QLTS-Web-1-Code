<div class="container-fluid p-0">
  <div class="card">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 fw-bold text-dark">Bảo trì & Báo hỏng thiết bị</h5>
        <small class="text-muted">Theo dõi và xử lý các sự cố thiết bị trong hệ thống</small>
      </div>
      <a href="/maintenance/create" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Báo hỏng thiết bị
      </a>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3">#</th>
            <th scope="col">Mã phiếu</th>
            <th scope="col">Tài sản gặp sự cố</th>
            <th scope="col">Mô tả sự cố</th>
            <th scope="col">Ngày báo</th>
            <th scope="col">Chi phí</th>
            <th scope="col">Trạng thái</th>
            <th scope="col" class="text-end pe-3">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each orders}}
            <tr>
              <td class="ps-3 text-muted">{{addOne @index}}</td>
              <td class="fw-semibold text-dark">{{this.code}}</td>
              <td>
                <a href="/assets/{{this.asset_id}}" class="text-dark text-decoration-none fw-semibold">
                  [{{this.asset_code}}] {{this.asset_name}}
                </a>
              </td>
              <td class="text-secondary small">{{this.cause}}</td>
              <td class="text-muted small">{{formatDate this.started_at}}</td>
              <td class="text-dark">
                {{#if this.cost}}{{formatCurrency this.cost}}{{else}}—{{/if}}
              </td>
              <td>
                {{#if (eq this.status "done")}}
                  <span class="badge text-bg-light border text-success">Đã sửa xong</span>
                {{else}}
                  <span class="badge text-bg-warning text-dark">Đang sửa chữa</span>
                {{/if}}
              </td>
              <td class="text-end pe-3 text-nowrap">
                {{#if (not (eq this.status "done"))}}
                  <button type="button" class="btn btn-success btn-sm" onclick="openComplete('{{this.id}}', '{{this.code}}')">
                    Hoàn thành
                  </button>
                {{else}}
                  <span class="text-muted small">Đã đóng</span>
                {{/if}}
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">Không có thiết bị nào đang gặp sự cố.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Modal Nghiệm thu hoàn thành sửa chữa -->
<div class="modal fade" id="modalComplete" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="formComplete" method="POST">
        <div class="modal-header">
          <h6 class="modal-title fw-bold text-dark" id="modalTitle">Nghiệm thu sửa chữa</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Chi phí sửa chữa (VNĐ)</label>
            <input type="number" class="form-control" name="cost" value="200000" min="0" required />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-primary btn-sm">Xác nhận hoàn thành</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openComplete(id, code) {
    document.getElementById('formComplete').action = '/maintenance/' + id + '/complete';
    document.getElementById('modalTitle').innerText = 'Hoàn thành sửa chữa: ' + code;
    new bootstrap.Modal(document.getElementById('modalComplete')).show();
  }
</script>
