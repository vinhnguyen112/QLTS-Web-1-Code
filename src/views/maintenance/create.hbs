<div class="container-fluid p-0">
  <div class="card border shadow-none" style="max-width: 650px; margin: auto;">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h5 class="mb-0 fw-bold text-dark">Báo hỏng thiết bị</h5>
      <a href="/maintenance" class="btn btn-secondary btn-sm">Quay lại</a>
    </div>

    <form action="/maintenance/create" method="POST">
      <div class="card-body p-4">
        <div class="mb-3">
          <label class="form-label small fw-semibold">Chọn tài sản gặp sự cố <span class="text-danger">*</span></label>
          <select class="form-select" name="asset_id" required>
            <option value="">-- Chọn tài sản --</option>
            {{#each assets}}
              <option value="{{this.id}}">[{{this.code}}] {{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="mb-4">
          <label class="form-label small fw-semibold">Mô tả triệu chứng hỏng hóc <span class="text-danger">*</span></label>
          <textarea class="form-control" name="cause" rows="4" placeholder="Ví dụ: Máy không lên nguồn, quạt kêu to..." required></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2 border-top pt-3">
          <a href="/maintenance" class="btn btn-secondary btn-sm">Hủy bỏ</a>
          <button type="submit" class="btn btn-danger btn-sm px-4">Xác nhận báo hỏng</button>
        </div>
      </div>
    </form>
  </div>
</div>
