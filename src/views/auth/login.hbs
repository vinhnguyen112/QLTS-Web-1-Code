<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - Quản Lý Tài Sản</title>
  <!-- Bootswatch Flatly (Bootstrap 5.3) -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/flatly/bootstrap.min.css">
  <style>
    body {
      background-color: #f8f9fa;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    .login-card {
      background: #ffffff;
      border: 1px solid #dee2e6;
      border-radius: 0.5rem;
      max-width: 440px;
      width: 100%;
    }
    .demo-pill {
      cursor: pointer;
      font-size: 0.8rem;
      padding: 0.25rem 0.5rem;
      border-radius: 0.25rem;
      border: 1px solid #dee2e6;
      background: #ffffff;
      color: #212529;
    }
    .demo-pill:hover {
      background: #e9ecef;
    }
  </style>
</head>
<body>

<div class="container py-4">
  <div class="login-card mx-auto">
    <div class="p-4">
      <div class="text-center mb-4">
        <h4 class="fw-bold text-dark mb-1">Đăng nhập</h4>
        <p class="text-muted small">Hệ thống quản lý tài sản doanh nghiệp</p>
      </div>

      {{#if error}}
      <div class="alert alert-danger py-2 px-3 small mb-3 d-flex align-items-center">
        <i class="bi bi-exclamation-circle-fill me-2 fs-6"></i>
        <div>{{error}}</div>
      </div>
      {{/if}}

      <form action="/auth/login" method="POST">
        <div class="mb-3">
          <label class="form-label small fw-semibold text-dark">Tên đăng nhập</label>
          <input type="text" name="username" id="usernameInput" class="form-control" placeholder="Tên đăng nhập" value="{{username}}" required autofocus>
        </div>

        <div class="mb-3">
          <label class="form-label small fw-semibold text-dark">Mật khẩu</label>
          <input type="password" name="password" id="passwordInput" class="form-control" placeholder="Mật khẩu" required>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">
          Đăng nhập
        </button>
      </form>

      <!-- Gợi ý tài khoản demo -->
      <div class="mt-4 pt-3 border-top">
        <div class="small fw-semibold text-muted mb-2">Tài khoản demo (click để điền):</div>
        <div class="d-flex flex-wrap gap-1">
          <span class="demo-pill" onclick="fillForm('admin', 'Admin@QLTS2026!')">
            admin (SysAdmin)
          </span>
          <span class="demo-pill" onclick="fillForm('gd.trinh', 'Devmaster@2026!')">
            gd.trinh (Giám đốc)
          </span>
          <span class="demo-pill" onclick="fillForm('tp.csvc', 'Devmaster@2026!')">
            tp.csvc (QL Tài sản)
          </span>
          <span class="demo-pill" onclick="fillForm('tp.ketoan', 'Devmaster@2026!')">
            tp.ketoan (Kế toán trưởng)
          </span>
          <span class="demo-pill" onclick="fillForm('nv.hcns.1', 'Devmaster@2026!')">
            nv.hcns.1 (Nhân viên)
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function fillForm(user, pass) {
    document.getElementById('usernameInput').value = user;
    document.getElementById('passwordInput').value = pass;
  }
</script>

</body>
</html>
