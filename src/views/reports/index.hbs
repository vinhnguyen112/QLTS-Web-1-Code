<div class="container-fluid p-0">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="mb-1 text-dark">Báo cáo & Thống kê tài sản</h4>
      <p class="text-muted mb-0 small">
        Tổng hợp dữ liệu phân bổ và giá trị tài sản trong doanh nghiệp
      </p>
    </div>
  </div>

  <!-- Bảng tổng hợp tổng số lượng và nguyên giá -->
  <div class="card mb-3">
    <div class="card-header">
      Tổng hợp chung
    </div>
    <div class="table-responsive">
      <table class="table table-bordered align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Chỉ số thống kê</th>
            <th class="text-end" style="width: 250px;">Giá trị</th>
            <th>Ghi chú</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Tổng số lượng tài sản hiện có</td>
            <td class="text-end fw-semibold">{{grandTotalAssets}} tài sản</td>
            <td class="text-muted small">Bao gồm toàn bộ tài sản đang sử dụng, lưu kho và bảo trì</td>
          </tr>
          <tr>
            <td>Tổng nguyên giá tài sản</td>
            <td class="text-end fw-semibold">{{formatCurrency grandTotalCost}} đ</td>
            <td class="text-muted small">Tổng giá trị mua ban đầu của các tài sản chưa thanh lý</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bảng 1: Báo cáo theo phòng ban -->
  <div class="card mb-3">
    <div class="card-header">
      1. Thống kê tài sản theo phòng ban
    </div>
    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">STT</th>
            <th>Tên phòng ban</th>
            <th class="text-center" style="width: 180px;">Số lượng tài sản</th>
            <th class="text-end" style="width: 220px;">Tổng giá trị (VNĐ)</th>
          </tr>
        </thead>
        <tbody>
          {{#each byDepartment}}
            <tr>
              <td class="text-center">{{addOne @index}}</td>
              <td>{{this.department_name}}</td>
              <td class="text-center">{{this.total_assets}}</td>
              <td class="text-end">{{formatCurrency this.total_cost}} đ</td>
            </tr>
          {{else}}
            <tr>
              <td colspan="4" class="text-center text-muted py-3">Chưa có dữ liệu</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bảng 2: Báo cáo theo danh mục loại tài sản -->
  <div class="card">
    <div class="card-header">
      2. Thống kê tài sản theo danh mục loại tài sản
    </div>
    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">STT</th>
            <th>Tên danh mục</th>
            <th class="text-center" style="width: 180px;">Số lượng tài sản</th>
            <th class="text-end" style="width: 220px;">Tổng giá trị (VNĐ)</th>
          </tr>
        </thead>
        <tbody>
          {{#each byCategory}}
            <tr>
              <td class="text-center">{{addOne @index}}</td>
              <td>{{this.category_name}}</td>
              <td class="text-center">{{this.total_assets}}</td>
              <td class="text-end">{{formatCurrency this.total_cost}} đ</td>
            </tr>
          {{else}}
            <tr>
              <td colspan="4" class="text-center text-muted py-3">Chưa có dữ liệu</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
