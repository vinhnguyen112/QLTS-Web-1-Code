<div class="container-fluid p-0">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="mb-1">Báo cáo & Thống kê</h3>
      <p class="text-muted mb-0">
        Tổng hợp tình hình phân bổ và giá trị tài sản trong doanh nghiệp
      </p>
    </div>

    <button type="button" class="btn btn-secondary" onclick="window.print()">
      <i class="fa-solid fa-print me-1"></i> In báo cáo
    </button>
  </div>

  <!-- Thống kê tổng quan -->
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card p-3">
        <div class="text-muted small">Tổng số lượng tài sản</div>
        <h3 class="mt-2 mb-0 text-primary fw-bold">{{grandTotalAssets}} tài sản</h3>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card p-3">
        <div class="text-muted small">Tổng giá trị tài sản</div>
        <h3 class="mt-2 mb-0 text-danger fw-bold">{{formatCurrency grandTotalCost}} VNĐ</h3>
      </div>
    </div>
  </div>

  <!-- Bảng 1: Báo cáo theo phòng ban -->
  <div class="card mb-4">
    <div class="card-header py-3">
      1. Thống kê tài sản theo phòng ban
    </div>
    <div class="table-responsive">
      <table class="table table-bordered align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 60px;">STT</th>
            <th>Tên phòng ban</th>
            <th class="text-center" style="width: 180px;">Số lượng tài sản</th>
            <th class="text-end" style="width: 220px;">Tổng giá trị (VNĐ)</th>
          </tr>
        </thead>
        <tbody>
          {{#each byDepartment}}
            <tr>
              <td class="text-center">{{addOne @index}}</td>
              <td class="fw-medium">{{this.department_name}}</td>
              <td class="text-center">{{this.total_assets}}</td>
              <td class="text-end fw-semibold">{{formatCurrency this.total_cost}} VNĐ</td>
            </tr>
          {{else}}
            <tr>
              <td colspan="4" class="text-center text-muted py-3">Chưa có dữ liệu</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bảng 2: Báo cáo theo danh mục -->
  <div class="card">
    <div class="card-header py-3">
      2. Thống kê tài sản theo danh mục loại tài sản
    </div>
    <div class="table-responsive">
      <table class="table table-bordered align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 60px;">STT</th>
            <th>Tên danh mục</th>
            <th class="text-center" style="width: 180px;">Số lượng tài sản</th>
            <th class="text-end" style="width: 220px;">Tổng giá trị (VNĐ)</th>
          </tr>
        </thead>
        <tbody>
          {{#each byCategory}}
            <tr>
              <td class="text-center">{{addOne @index}}</td>
              <td class="fw-medium">{{this.category_name}}</td>
              <td class="text-center">{{this.total_assets}}</td>
              <td class="text-end fw-semibold">{{formatCurrency this.total_cost}} VNĐ</td>
            </tr>
          {{else}}
            <tr>
              <td colspan="4" class="text-center text-muted py-3">Chưa có dữ liệu</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
