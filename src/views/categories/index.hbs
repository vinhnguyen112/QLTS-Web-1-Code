<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="mb-1">Danh mục tài sản</h3>
            <p class="text-secondary mb-0">
                Quản lý các danh mục tài sản trong hệ thống
            </p>
        </div>

        <button type="button"
                class="btn btn-primary "
                data-bs-toggle="modal"
                data-bs-target="#addCategoryModal">
            Thêm danh mục
        </button>
    </div>

  <div class="card mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-7">
          <label class="form-label">
            Tìm kiếm
          </label>
          <input
            type="text"
            class="form-control"
            placeholder="Mã danh mục hoặc tên danh mục..."
          />
        </div>

        <div class="col-md-4">
          <label class="form-label">
            Danh mục
          </label>
          <select class="form-select">
            <option selected>Tất cả danh mục</option>
            <option>Máy tính</option>
            <option>Máy in</option>
            <option>Thiết bị văn phòng</option>
          </select>
        </div>

        <div class="col-md-1 d-flex align-items-end">
          <button class="btn btn-secondary w-100">
            Lọc
          </button>
        </div>
      </div>
    </div>
  </div>

    <div class="card">
        <div class="card-header">
            Danh sách danh mục tài sản
        </div>

        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Mã danh mục</th>
                        <th>Tên danh mục</th>
                        <th>Mô tả</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                      {{#each categories}}
                    <tr>
                        <td>{{@index}}</td>
                        <td>{{this.category_code}}</td>
                        <td>{{this.category_name}}</td>
                        <td>{{this.description}}</td>
                        <td>
                            <a href="/categories/{{this.category_id}}/edit" class="btn btn-sm btn-warning"> Sửa </a>
                            <button class="btn btn-sm btn-danger"> Xóa</button>
                        </td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade"
     id="addCategoryModal"
     tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            {{> categories-create}}
        </div>
    </div>
</div>