<div class="container-fluid">
  <div class="card">
    <div class="card-header">
      <div class="row align-items-center g-2">
        <div class="col">
          <h5 class="mb-0">Danh mục tài sản</h5>
          <small class="text-muted">Quản lý các danh mục tài sản trong hệ thống</small>
        </div>

        <div class="col-auto d-flex align-items-center gap-2">
          <form action="/categories" method="get" class="m-0" role="search">
            <div class="input-group">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm danh mục..."
              />
              <button class="btn btn-secondary" type="submit">Lọc</button>
            </div>
          </form>
          <button
            type="button"
            class="btn btn-sm btn-secondary"
            data-bs-toggle="modal"
            data-bs-target="#addCategoryModal"
          >+ Thêm danh mục</button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">STT</th>
            <th>Mã danh mục</th>
            <th>Tên danh mục</th>
            <th>Khấu hao chuẩn</th>
            <th>Mô tả</th>
            <th class="text-center" style="width: 160px;">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each categories}}
            <tr>
              <td class="text-center">{{addOne @index}}</td>
              <td><span class="badge bg-light text-dark border">{{this.category_code}}</span></td>
              <td>{{this.category_name}}</td>
              <td>{{this.default_useful_months}} tháng</td>
              <td>{{this.description}}</td>
              <td>
                <div class="d-flex justify-content-center gap-1">
                  <a href="/categories/{{this.category_id}}" class="btn btn-sm btn-success">Xem</a>
                  <a href="/categories/{{this.category_id}}/edit" class="btn btn-sm btn-warning">Sửa</a>
                  <form
                    action="/categories/{{this.category_id}}/delete"
                    method="POST"
                    class="m-0"
                    onsubmit="return confirm('Bạn có chắc chắn muốn xóa danh mục này không?');"
                  >
                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">Chưa có danh mục nào.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

  </div>
</div>

<div class="modal fade" id="addCategoryModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      {{> categories-create}}
    </div>
  </div>
</div>

{{#if pages.length}}
  <nav class="mt-3">
    <ul class="pagination">
      {{#each pages}}
        <li class="page-item {{#if active}}active{{/if}}">
          <a
            class="page-link"
            href="/categories?page={{number}}&name={{../searchName}}"
          >
            {{number}}
          </a>
        </li>
      {{/each}}
    </ul>
  </nav>
{{/if}}