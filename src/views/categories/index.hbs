<div class="container-fluid p-0">
  <div class="card">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-6">
          <h5 class="mb-0 fw-bold text-dark">Danh mục phân loại tài sản</h5>
          <small class="text-muted">Nhóm tài sản và quy định thời hạn trích khấu hao chuẩn</small>
        </div>

        <div class="col-md-6 d-flex flex-wrap justify-content-md-end align-items-center gap-2">
          <form action="/categories" method="get" class="m-0" role="search">
            <div class="input-group input-group-sm" style="width: 220px;">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm mã hoặc tên..."
              />
              <button class="btn btn-primary" type="submit">Tìm</button>
            </div>
          </form>
          <button
            type="button"
            class="btn btn-sm btn-success"
            data-bs-toggle="modal"
            data-bs-target="#addCategoryModal"
          >
            Thêm danh mục
          </button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3 text-nowrap">#</th>
            <th scope="col" class="text-nowrap">Mã danh mục</th>
            <th scope="col">Tên danh mục</th>
            <th scope="col">Thời hạn chuẩn</th>
            <th scope="col">Số tài sản thuộc nhóm</th>
            <th scope="col" class="text-end pe-3 text-nowrap">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each categories}}
            <tr>
              <th scope="row" class="ps-3 text-muted">{{addOne @index}}</th>
              <td class="fw-bold text-dark">{{this.code}}</td>
              <td class="text-dark">{{this.name}}</td>
              <td><span class="badge text-bg-light border">{{this.default_life_months}} tháng</span></td>
              <td><span class="badge text-bg-light border">{{this.asset_count}} tài sản</span></td>
              <td class="text-end pe-3">
                <div class="btn-group" role="group" aria-label="Basic mixed styles example">
                  <a href="/categories/{{this.id}}/edit" class="btn btn-warning">
                    Sửa
                  </a>
                  <form
                    action="/categories/{{this.id}}/delete"
                    method="POST"
                    class="d-inline m-0"
                    onsubmit="return confirm('Bạn có chắc chắn muốn ngưng sử dụng danh mục này?');"
                  >
                    <button type="submit" class="btn btn-danger">
                      Xóa
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy danh mục nào.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Phân trang -->
    {{#if (gt totalPages 1)}}
    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
      <small class="text-muted">Trang {{pages.[0].number}} / {{totalPages}}</small>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          {{#each pages}}
            <li class="page-item {{#if this.active}}active{{/if}}">
              <a class="page-link" href="/categories?page={{this.number}}&name={{../searchName}}">
                {{this.number}}
              </a>
            </li>
          {{/each}}
        </ul>
      </nav>
    </div>
    {{/if}}
  </div>
</div>

<!-- Modal Thêm Danh Mục -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/categories" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fw-bold text-dark">Thêm danh mục mới</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label small fw-semibold">Mã danh mục <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="code" placeholder="Ví dụ: LAPTOP, MONITOR, SERVER" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Tên danh mục <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" placeholder="Ví dụ: Máy tính xách tay" required />
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Thời hạn trích khấu hao chuẩn (Tháng) <span class="text-danger">*</span></label>
            <input type="number" class="form-control" name="default_life_months" value="36" min="1" required />
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-success btn-sm px-3">
            Lưu danh mục
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
