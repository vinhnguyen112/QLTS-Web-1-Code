<form action="/assets" method="POST">
  <div class="modal-header">
    <h5 class="modal-title">Thêm tài sản mới vào kho</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
  </div>
  <div class="modal-body">
    <h6 class="mb-3 text-primary">1. Thông tin định danh</h6>
    <div class="row">
      <div class="col-md-6 mb-3">
        <label for="asset_code" class="form-label">
          Mã tài sản <span class="text-danger">*</span>
        </label>
        <input
          type="text"
          class="form-control"
          id="asset_code"
          name="asset_code"
          placeholder="Ví dụ: TS001, TS-DELL-01..."
          required
        />
      </div>

      <div class="col-md-6 mb-3">
        <label for="asset_name" class="form-label">
          Tên tài sản <span class="text-danger">*</span>
        </label>
        <input
          type="text"
          class="form-control"
          id="asset_name"
          name="asset_name"
          placeholder="Ví dụ: Laptop Dell Vostro 5410"
          required
        />
      </div>

      <div class="col-md-6 mb-3">
        <label for="category_id" class="form-label">
          Loại tài sản <span class="text-danger">*</span>
        </label>
        <select class="form-select" id="category_id" name="category_id" required>
          <option value="">-- Chọn loại tài sản --</option>
          {{#each categories}}
            <option value="{{this.category_id}}" data-months="{{this.default_useful_months}}">
              {{this.category_name}}
            </option>
          {{/each}}
        </select>
      </div>

      <div class="col-md-6 mb-3">
        <label for="supplier_id" class="form-label">Nhà cung cấp</label>
        <select class="form-select" id="supplier_id" name="supplier_id">
          <option value="">-- Chọn nhà cung cấp --</option>
          {{#each suppliers}}
            <option value="{{this.supplier_id}}">{{this.supplier_name}}</option>
          {{/each}}
        </select>
      </div>
    </div>

    <hr class="my-2" />
    <h6 class="mb-3 text-primary">2. Giá trị & Khấu hao</h6>
    <div class="row">
      <div class="col-md-4 mb-3">
        <label for="original_cost" class="form-label">
          Nguyên giá mua (VNĐ) <span class="text-danger">*</span>
        </label>
        <input
          type="number"
          class="form-control"
          id="original_cost"
          name="original_cost"
          placeholder="Ví dụ: 18500000"
          min="0"
          required
        />
      </div>

      <div class="col-md-4 mb-3">
        <label for="purchase_date" class="form-label">Ngày mua / Nhập kho <span class="text-danger">*</span></label>
        <input
          type="date"
          class="form-control"
          id="purchase_date"
          name="purchase_date"
          required
        />
      </div>

      <div class="col-md-4 mb-3">
        <label for="useful_life_months" class="form-label">
          Thời gian khấu hao (tháng)
        </label>
        <input
          type="number"
          class="form-control"
          id="useful_life_months"
          name="useful_life_months"
          value="36"
          min="1"
          required
        />
      </div>
    </div>

    <div class="alert alert-light border py-2 mb-0 small text-muted">
      Tài sản mới tạo sẽ mặc định ở trạng thái: <strong>Trong kho</strong> (chưa bàn giao cho nhân sự). Sau khi nhập kho, bạn có thể thực hiện thao tác Bàn giao tại hồ sơ chi tiết.
    </div>
  </div>

  <div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
    <button type="submit" class="btn btn-secondary">Lưu tài sản vào kho</button>
  </div>
</form>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const pDate = document.getElementById('purchase_date');
    if (pDate && !pDate.value) {
      pDate.value = new Date().toISOString().split('T')[0];
    }

    const catSelect = document.getElementById('category_id');
    const monthsInput = document.getElementById('useful_life_months');
    if (catSelect && monthsInput) {
      catSelect.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        const defaultMonths = selectedOption.getAttribute('data-months');
        if (defaultMonths) {
          monthsInput.value = defaultMonths;
        }
      });
    }
  });
</script>