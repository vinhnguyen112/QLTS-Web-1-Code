<div class="container-fluid p-0">
  <div class="card mb-4">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-6">
          <div class="d-flex align-items-center gap-2">
            <a href="/assets" class="btn btn-secondary btn-sm">Quay lại</a>
            <div>
              <h5 class="mb-0 fw-bold text-dark">Hồ sơ tài sản: {{asset.code}}</h5>
              <small class="text-muted">Quản lý bởi: {{asset.org_unit_name}}</small>
            </div>
          </div>
        </div>
        <div class="col-md-6 d-flex flex-wrap justify-content-md-end gap-2">
          {{#if canManageAssets}}
            {{#if (eq asset.status "in_use")}}
              <form
                action="/assets/{{asset.id}}/recall"
                method="POST"
                class="d-inline m-0 p-0"
                onsubmit="return confirm('Bạn có chắc chắn muốn thu hồi tài sản này về lại kho trung tâm?');"
              >
                <button type="submit" class="btn btn-sm btn-secondary">
                  Thu hồi về kho
                </button>
              </form>
            {{/if}}

            <a href="/assets/{{asset.id}}/edit" class="btn btn-sm btn-secondary">
              Chỉnh sửa
            </a>
          {{/if}}

          <a href="/maintenance/create?asset_id={{asset.id}}" class="btn btn-sm btn-secondary">
            Báo hỏng / Sửa chữa
          </a>

          <button onclick="window.print()" class="btn btn-sm btn-dark">
            In tem QR
          </button>
        </div>
      </div>
    </div>

    <div class="card-body">
      <div class="row g-4">
        <!-- Cột thông tin chi tiết -->
        <div class="col-lg-8">
          <div class="bg-light p-3 rounded mb-4 border">
            <div class="row g-3">
              <div class="col-sm-6">
                <span class="text-muted small d-block">Tên tài sản:</span>
                <span class="fs-6 fw-bold text-dark">{{asset.name}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Mã định danh:</span>
                <span class="fw-semibold text-dark">{{asset.code}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Danh mục:</span>
                <span class="badge text-bg-light border">{{asset.category_name}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Số Serial:</span>
                <span class="text-dark">{{#if asset.serial_no}}{{asset.serial_no}}{{else}}<em>Chưa có</em>{{/if}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Nguyên giá:</span>
                <span class="fs-5 fw-bold text-dark">{{formatCurrency asset.original_cost}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Ngày mua:</span>
                <span class="text-dark">{{formatDate asset.purchase_date}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Thời gian sử dụng:</span>
                <span class="text-dark">{{asset.useful_life_months}} tháng</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Trạng thái:</span>
                <div>{{{assetStatusBadge asset.status}}}</div>
              </div>
            </div>
          </div>

          <!-- Phân bổ & Vị trí -->
          <h6 class="fw-bold text-dark mb-3">Hiện trạng phân bổ & Bàn giao</h6>
          <div class="row g-3 mb-4">
            <div class="col-sm-4">
              <div class="border p-3 rounded bg-white">
                <small class="text-muted d-block">Phòng ban quản lý:</small>
                <div class="fw-semibold text-dark mt-1">{{asset.org_unit_name}}</div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="border p-3 rounded bg-white">
                <small class="text-muted d-block">Vị trí lắp đặt:</small>
                <div class="fw-semibold text-dark mt-1">{{#if asset.location_name}}{{asset.location_name}}{{else}}Kho trung tâm{{/if}}</div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="border p-3 rounded bg-white">
                <small class="text-muted d-block">Người đang giữ:</small>
                <div class="fw-semibold text-dark mt-1">
                  {{#if asset.current_employee_name}}
                    {{asset.current_employee_name}}
                  {{else}}
                    <span class="text-muted fst-italic">Trong kho</span>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>

          <!-- Nhà cung cấp -->
          {{#if asset.supplier_name}}
          <div class="p-3 bg-white rounded border mb-4">
            <small class="text-muted d-block">Đơn vị cung cấp:</small>
            <div class="fw-semibold text-dark">{{asset.supplier_name}}</div>
          </div>
          {{/if}}
        </div>

        <!-- Cột Tem mã QR -->
        <div class="col-lg-4 text-center">
          <div class="card p-3 bg-white">
            <h6 class="fw-bold text-dark mb-2">Tem mã QR tra cứu</h6>
            <div class="p-2 border rounded bg-light d-inline-block mx-auto mb-2">
              <img src="{{qrCodeDataUrl}}" alt="QR Code" class="img-fluid" style="width: 160px; height: 160px;" />
            </div>
            <div class="small fw-bold text-dark">{{asset.code}}</div>
            <small class="text-muted mb-3 d-block">Quét mã bằng camera điện thoại để đối chiếu hoặc kiểm kê</small>
            <button onclick="window.print()" class="btn btn-secondary btn-sm w-100">
              In tem QR
            </button>
          </div>
        </div>
      </div>

      <!-- Nhật ký biến động tài sản -->
      <div class="mt-4 pt-3 border-top">
        <h6 class="fw-bold text-dark mb-3">Nhật ký luân chuyển & Biến động</h6>
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Thời gian</th>
                <th>Sự kiện</th>
                <th>Từ trạng thái</th>
                <th>Sang trạng thái</th>
                <th>Người thực hiện</th>
                <th>Ghi chú</th>
              </tr>
            </thead>
            <tbody>
              {{#each events}}
              <tr>
                <td class="text-muted small">{{formatDateTime this.created_at}}</td>
                <td><span class="badge text-bg-light border">{{this.event_type}}</span></td>
                <td>{{this.from_status}}</td>
                <td><span class="text-dark">{{this.to_status}}</span></td>
                <td>{{#if this.actor_name}}{{this.actor_name}}{{else}}Hệ thống{{/if}}</td>
                <td>{{this.note}}</td>
              </tr>
              {{else}}
              <tr>
                <td colspan="6" class="text-center py-3 text-muted small">Chưa phát sinh biến động nào</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
