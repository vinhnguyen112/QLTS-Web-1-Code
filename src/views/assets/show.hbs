<div class="container-fluid">
    <div class="mb-4">
        <h3 class="mb-1">Chi tiết tài sản</h3>
        <p class="text-secondary mb-0">
            Thông tin chi tiết của tài sản
        </p>
    </div>

    <!-- Thông tin chi tiết tài sản -->
    <div class="card mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0">Thông tin tài sản</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Mã tài sản:</strong>
                    <div>{{asset.asset_code}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Tên tài sản:</strong>
                    <div>{{asset.asset_name}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Danh mục:</strong>
                    <div>{{asset.category_name}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Số serial:</strong>
                    <div>{{#if asset.serial_number}}{{asset.serial_number}}{{else}}<span class="text-muted">(Không có)</span>{{/if}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Ngày mua:</strong>
                    <div>{{formatDate asset.purchase_date}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Giá trị:</strong>
                    <div>{{formatCurrency asset.original_cost}} VNĐ</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Vị trí:</strong>
                    <div>{{#if asset.location}}{{asset.location}}{{else}}<span class="text-muted">(Chưa cập nhật)</span>{{/if}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Phòng ban:</strong>
                    <div>{{#if asset.department_name}}{{asset.department_name}}{{else}}<span class="text-muted">(Chưa phân bổ)</span>{{/if}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Người sử dụng:</strong>
                    <div>{{#if asset.full_name}}{{asset.full_name}}{{else}}<span class="text-muted">(Chưa bàn giao)</span>{{/if}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Trạng thái:</strong>
                    <div>
                        {{#if (eq asset.status "in_use")}}
                            <span class="badge bg-success">Đang sử dụng</span>
                        {{else if (eq asset.status "in_stock")}}
                            <span class="badge bg-secondary">Trong kho</span>
                        {{else if (eq asset.status "maintenance")}}
                            <span class="badge bg-warning text-dark">Đang bảo trì</span>
                        {{else}}
                            <span class="badge bg-light text-dark">{{asset.status}}</span>
                        {{/if}}
                    </div>
                </div>
                <div class="col-12 mb-3">
                    <strong>Mô tả:</strong>
                    <div>{{#if asset.description}}{{asset.description}}{{else}}<span class="text-muted">(Không có mô tả)</span>{{/if}}</div>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <a href="/assets" class="btn btn-secondary">Quay lại danh sách</a>
                <a href="/assets/{{asset.asset_id}}/edit" class="btn btn-warning">Chỉnh sửa</a>
            </div>
        </div>
    </div>
</div>