<div class="container-fluid p-0">
  <div class="card mb-4">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-6">
          <div class="d-flex align-items-center gap-2">
            <a href="/assets" class="btn btn-secondary btn-sm">Quay lại</a>
            <div>
              <h5 class="mb-0 fw-bold text-dark">Hồ sơ tài sản: {{asset.code}}</h5>
              <small class="text-muted">Quản lý bởi: {{asset.org_unit_name}}</small>
            </div>
          </div>
        </div>
        <div class="col-md-6 d-flex flex-wrap justify-content-md-end gap-2">
          {{#if canManageAssets}}
            {{#if (eq asset.status "in_stock")}}
              <button
                type="button"
                class="btn btn-sm btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#assignModal"
              >
                <i class="bi bi-person-check me-1"></i> Bàn giao / Cấp phát
              </button>
            {{/if}}

            {{#if (eq asset.status "in_use")}}
              <form
                action="/assets/{{asset.id}}/recall"
                method="POST"
                class="d-inline m-0 p-0"
                onsubmit="return confirm('Bạn có chắc chắn muốn thu hồi tài sản này về lại kho trung tâm?');"
              >
                <button type="submit" class="btn btn-sm btn-outline-danger">
                  <i class="bi bi-box-arrow-in-left me-1"></i> Thu hồi về kho
                </button>
              </form>
            {{/if}}

            <a href="/assets/{{asset.id}}/edit" class="btn btn-sm btn-secondary">
              Chỉnh sửa
            </a>
          {{/if}}

          <a href="/maintenance/create?asset_id={{asset.id}}" class="btn btn-sm btn-secondary">
            Báo hỏng / Sửa chữa
          </a>

          <button onclick="window.print()" class="btn btn-sm btn-dark">
            In tem QR
          </button>
        </div>
      </div>
    </div>

    <div class="card-body">
      <div class="row g-4">
        <!-- Cột thông tin chi tiết -->
        <div class="col-lg-8">
          <div class="bg-light p-3 rounded mb-4 border">
            <div class="row g-3">
              <div class="col-sm-6">
                <span class="text-muted small d-block">Tên tài sản:</span>
                <span class="fs-6 fw-bold text-dark">{{asset.name}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Mã định danh:</span>
                <span class="fw-semibold text-dark">{{asset.code}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Danh mục:</span>
                <span class="badge text-bg-light border">{{asset.category_name}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Số Serial:</span>
                <span class="text-dark">{{#if asset.serial_no}}{{asset.serial_no}}{{else}}<em>Chưa có</em>{{/if}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Nguyên giá:</span>
                <span class="fs-5 fw-bold text-dark">{{formatCurrency asset.original_cost}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Ngày mua:</span>
                <span class="text-dark">{{formatDate asset.purchase_date}}</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Thời gian sử dụng:</span>
                <span class="text-dark">{{asset.useful_life_months}} tháng</span>
              </div>
              <div class="col-sm-6">
                <span class="text-muted small d-block">Trạng thái:</span>
                <div>{{{assetStatusBadge asset.status}}}</div>
              </div>
            </div>
          </div>

          <!-- Phân bổ & Vị trí -->
          <h6 class="fw-bold text-dark mb-3">Hiện trạng phân bổ & Bàn giao</h6>
          <div class="row g-3 mb-4">
            <div class="col-sm-4">
              <div class="border p-3 rounded bg-white">
                <small class="text-muted d-block">Phòng ban quản lý:</small>
                <div class="fw-semibold text-dark mt-1">{{asset.org_unit_name}}</div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="border p-3 rounded bg-white">
                <small class="text-muted d-block">Vị trí lắp đặt:</small>
                <div class="fw-semibold text-dark mt-1">{{#if asset.location_name}}{{asset.location_name}}{{else}}Kho trung tâm{{/if}}</div>
              </div>
            </div>
            <div class="col-sm-4">
              <div class="border p-3 rounded bg-white">
                <small class="text-muted d-block">Người đang giữ:</small>
                <div class="fw-semibold text-dark mt-1">
                  {{#if asset.current_employee_name}}
                    <i class="bi bi-person me-1 text-secondary"></i>{{asset.current_employee_name}}
                  {{else if (eq asset.status "in_use")}}
                    <span class="text-primary"><i class="bi bi-people me-1"></i>Sử dụng chung ({{asset.org_unit_name}})</span>
                  {{else if (eq asset.status "in_stock")}}
                    <span class="badge text-bg-light text-muted border">Đang lưu kho</span>
                  {{else}}
                    <span class="text-muted fst-italic">Chưa bàn giao</span>
                  {{/if}}
                </div>
              </div>
            </div>
          </div>

          <!-- Nhà cung cấp -->
          {{#if asset.supplier_name}}
          <div class="p-3 bg-white rounded border mb-4">
            <small class="text-muted d-block">Đơn vị cung cấp:</small>
            <div class="fw-semibold text-dark">{{asset.supplier_name}}</div>
          </div>
          {{/if}}
        </div>

        <!-- Cột Tem mã QR -->
        <div class="col-lg-4 text-center">
          <div class="card p-3 bg-white">
            <h6 class="fw-bold text-dark mb-2">Tem mã QR tra cứu</h6>
            <div class="p-2 border rounded bg-light d-inline-block mx-auto mb-2">
              <img src="{{qrCodeDataUrl}}" alt="QR Code" class="img-fluid" style="width: 160px; height: 160px;" />
            </div>
            <div class="small fw-bold text-dark">{{asset.code}}</div>
            <small class="text-muted mb-3 d-block">Quét mã bằng camera điện thoại để đối chiếu hoặc kiểm kê</small>
            <button onclick="window.print()" class="btn btn-secondary btn-sm w-100">
              In tem QR
            </button>
          </div>
        </div>
      </div>

      <!-- Nhật ký biến động tài sản -->
      <div class="mt-4 pt-3 border-top">
        <h6 class="fw-bold text-dark mb-3">Nhật ký luân chuyển & Biến động</h6>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="text-nowrap">Thời gian</th>
                <th scope="col" class="text-nowrap">Sự kiện</th>
                <th scope="col" class="text-nowrap">Người thực hiện</th>
                <th scope="col">Chi tiết & Ghi chú</th>
              </tr>
            </thead>
            <tbody>
              {{#each events}}
              <tr>
                <td class="text-muted small">{{formatDateTime this.performed_at}}</td>
                <td><span class="badge text-bg-light border text-primary fw-semibold">{{this.event_type}}</span></td>
                <td>{{#if this.actor_name}}<span class="text-dark fw-semibold">{{this.actor_name}}</span>{{else}}<span class="text-muted">Hệ thống</span>{{/if}}</td>
                <td class="text-dark">{{this.note}}</td>
              </tr>
              {{else}}
              <tr>
                <td colspan="4" class="text-center py-4 text-muted small">Chưa phát sinh biến động nào</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Bàn giao / Cấp phát tài sản cho nhân sự -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/assets/{{asset.id}}/assign" method="POST">
        <div class="modal-header bg-light py-3">
          <h5 class="modal-title fs-6 fw-bold text-dark" id="assignModalLabel">
            <i class="bi bi-person-check me-1 text-primary"></i> Bàn giao tài sản cho nhân sự
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body p-4">
          <div class="mb-3">
            <label class="form-label text-muted small">Tài sản bàn giao:</label>
            <div class="p-2 bg-light border rounded fw-semibold text-dark">
              {{asset.code}} - {{asset.name}}
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Nhân viên tiếp nhận <span class="text-danger">*</span></label>
            <select name="assignee_id" class="form-select" required>
              <option value="">-- Chọn nhân viên tiếp nhận --</option>
              {{#each formData.users}}
                <option value="{{this.id}}">{{this.full_name}} ({{this.email}})</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Đơn vị quản lý mới</label>
            <select name="org_unit_id" class="form-select">
              <option value="">-- Giữ nguyên: {{asset.org_unit_name}} --</option>
              {{#each formData.orgUnits}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Vị trí bàn giao mới</label>
            <select name="location_id" class="form-select">
              <option value="">-- Chọn vị trí / phòng máy --</option>
              {{#each formData.locations}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Ghi chú bàn giao</label>
            <textarea name="note" class="form-control" rows="2" placeholder="Ghi chú tình trạng thiết bị khi bàn giao..."></textarea>
          </div>
        </div>
        <div class="modal-footer bg-light py-2">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="submit" class="btn btn-sm btn-primary">
            <i class="bi bi-check2-circle me-1"></i> Xác nhận bàn giao
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
