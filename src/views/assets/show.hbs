<div class="container-fluid p-0">
  <!-- Thanh điều hướng và nút hành động -->
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div class="d-flex align-items-center gap-2">
      <a href="/assets" class="btn btn-secondary btn-sm text-nowrap">
        Quay lại
      </a>
      <div>
        <div class="d-flex align-items-center gap-2">
          <h5 class="mb-0 fw-bold text-dark">{{asset.name}}</h5>
          {{{assetStatusBadge asset.status}}}
        </div>
        <small class="text-muted font-monospace">{{asset.code}}</small>
      </div>
    </div>

    <div class="d-flex flex-wrap gap-2">
      {{#if canManageAssets}}
        {{#if (eq asset.status "in_stock")}}
          <button
            type="button"
            class="btn btn-sm btn-primary text-nowrap"
            data-bs-toggle="modal"
            data-bs-target="#assignModal"
          >
            Bàn giao / Cấp phát
          </button>
        {{/if}}

        {{#if (eq asset.status "in_use")}}
          <form
            action="/assets/{{asset.id}}/recall"
            method="POST"
            class="d-inline m-0 p-0"
            onsubmit="return confirm('Bạn có chắc chắn muốn thu hồi tài sản này về lại kho trung tâm?');"
          >
            <button type="submit" class="btn btn-sm btn-warning text-nowrap">
              Thu hồi về kho
            </button>
          </form>
        {{/if}}

        <a href="/assets/{{asset.id}}/edit" class="btn btn-sm btn-secondary text-nowrap">
          Chỉnh sửa
        </a>
      {{/if}}

      <a href="/maintenance/create?asset_id={{asset.id}}" class="btn btn-sm btn-secondary text-nowrap">
        Báo hỏng / Sửa chữa
      </a>

      <button onclick="window.print()" class="btn btn-sm btn-dark text-nowrap">
        In tem QR
      </button>
    </div>
  </div>

  <div class="row g-3">
    <!-- Cột chính: Thông tin tài sản, Hiện trạng và Khấu hao -->
    <div class="col-lg-8">
      <!-- Khối 1: Thông tin chi tiết & Hiện trạng phân bổ -->
      <div class="card border shadow-none mb-3">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-bold text-dark">Thông tin tài sản & Hiện trạng phân bổ</h6>
        </div>
        <div class="card-body p-0">
          <div class="table-responsive">
            <table class="table table-borderless align-middle mb-0">
              <tbody>
                <tr class="border-bottom">
                  <td class="text-muted ps-3 py-2" style="width: 25%;">Tên tài sản</td>
                  <td class="fw-bold text-dark py-2" style="width: 25%;">{{asset.name}}</td>
                  <td class="text-muted py-2" style="width: 25%;">Phòng ban quản lý</td>
                  <td class="fw-semibold text-dark py-2" style="width: 25%;">{{asset.org_unit_name}}</td>
                </tr>
                <tr class="border-bottom">
                  <td class="text-muted ps-3 py-2">Mã định danh</td>
                  <td class="font-monospace fw-bold text-dark py-2">{{asset.code}}</td>
                  <td class="text-muted py-2">Vị trí lắp đặt</td>
                  <td class="text-dark py-2">{{#if asset.location_name}}{{asset.location_name}}{{else}}Kho trung tâm{{/if}}</td>
                </tr>
                <tr class="border-bottom">
                  <td class="text-muted ps-3 py-2">Danh mục</td>
                  <td class="py-2"><span class="badge text-bg-light border">{{asset.category_name}}</span></td>
                  <td class="text-muted py-2">Người đang giữ</td>
                  <td class="py-2">
                    {{#if asset.current_employee_name}}
                      <span class="fw-semibold text-dark">{{asset.current_employee_name}}</span>
                    {{else if (eq asset.status "in_use")}}
                      <span class="text-primary fw-semibold">Sử dụng chung</span>
                    {{else if (eq asset.status "in_stock")}}
                      <span class="text-muted">Đang lưu kho</span>
                    {{else}}
                      <span class="text-muted">Chưa bàn giao</span>
                    {{/if}}
                  </td>
                </tr>
                <tr class="border-bottom">
                  <td class="text-muted ps-3 py-2">Số Serial</td>
                  <td class="text-dark py-2">{{#if asset.serial_no}}{{asset.serial_no}}{{else}}<span class="text-muted">Chưa có</span>{{/if}}</td>
                  <td class="text-muted py-2">Đơn vị cung cấp</td>
                  <td class="text-dark py-2">{{#if asset.supplier_name}}{{asset.supplier_name}}{{else}}<span class="text-muted">Chưa có</span>{{/if}}</td>
                </tr>
                <tr>
                  <td class="text-muted ps-3 py-2">Ngày mua</td>
                  <td class="text-dark py-2">{{formatDate asset.purchase_date}}</td>
                  <td class="text-muted py-2">Trạng thái</td>
                  <td class="py-2">{{{assetStatusBadge asset.status}}}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Khối 2: Tóm tắt Khấu hao tài sản -->
      <div class="card border shadow-none mb-3">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
          <h6 class="mb-0 fw-bold text-dark">Khấu hao tài sản (Đường thẳng)</h6>
          {{#if depreciation.hasDepreciation}}
            <a href="/depreciation/{{asset.id}}" class="btn btn-primary btn-sm text-nowrap">
              Xem bảng phân bổ tháng
            </a>
          {{/if}}
        </div>
        <div class="card-body p-3">
          {{#if depreciation.hasDepreciation}}
            <div class="row g-2 mb-3">
              <div class="col-sm-3 col-6">
                <div class="p-2 border rounded bg-light">
                  <small class="text-muted d-block">Nguyên giá</small>
                  <span class="fw-bold text-dark">{{formatCurrency asset.original_cost}}</span>
                </div>
              </div>
              <div class="col-sm-3 col-6">
                <div class="p-2 border rounded bg-light">
                  <small class="text-muted d-block">Mức trích / Tháng</small>
                  <span class="fw-bold text-dark">{{formatCurrency depreciation.monthly}}</span>
                </div>
              </div>
              <div class="col-sm-3 col-6">
                <div class="p-2 border rounded bg-light">
                  <small class="text-muted d-block">Đã trích (Lũy kế)</small>
                  <span class="fw-bold text-dark">{{formatCurrency depreciation.accumulated}}</span>
                </div>
              </div>
              <div class="col-sm-3 col-6">
                <div class="p-2 border rounded bg-light">
                  <small class="text-muted d-block">Giá trị còn lại</small>
                  <span class="fw-bold text-success">{{formatCurrency depreciation.remainingValue}}</span>
                </div>
              </div>
            </div>
            <div>
              <div class="d-flex justify-content-between small text-muted mb-1">
                <span>Tiến độ khấu hao ({{depreciation.usedMonths}}/{{asset.useful_life_months}} tháng)</span>
                <span class="fw-bold text-dark">{{depreciation.percent}}%</span>
              </div>
              <div class="progress" style="height: 6px;">
                <div class="progress-bar bg-success" role="progressbar" style="width: {{depreciation.percent}}%;"></div>
              </div>
            </div>
          {{else}}
            <p class="text-muted small mb-0">Tài sản này không thiết lập thời gian sử dụng hữu ích hoặc không áp dụng trích khấu hao.</p>
          {{/if}}
        </div>
      </div>

      <!-- Khối 3: Nhật ký luân chuyển & Biến động -->
      <div class="card border shadow-none mb-3">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-bold text-dark">Nhật ký luân chuyển & Biến động</h6>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th scope="col" class="ps-3 text-nowrap">Thời gian</th>
                <th scope="col" class="text-nowrap">Sự kiện</th>
                <th scope="col" class="text-nowrap">Người thực hiện</th>
                <th scope="col" class="pe-3">Chi tiết & Ghi chú</th>
              </tr>
            </thead>
            <tbody>
              {{#each events}}
                <tr>
                  <td class="ps-3 text-muted small text-nowrap">{{formatDateTime this.performed_at}}</td>
                  <td><span class="badge text-bg-light border text-primary fw-semibold">{{this.event_type}}</span></td>
                  <td class="text-dark fw-semibold text-nowrap">
                    {{#if this.actor_name}}{{this.actor_name}}{{else}}<span class="text-muted">Hệ thống</span>{{/if}}
                  </td>
                  <td class="pe-3 text-dark small">{{this.note}}</td>
                </tr>
              {{else}}
                <tr>
                  <td colspan="4" class="text-center py-4 text-muted small">Chưa phát sinh biến động nào.</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Cột phụ: Tem mã QR tra cứu -->
    <div class="col-lg-4">
      <div class="card border shadow-none text-center p-3">
        <h6 class="fw-bold text-dark mb-2">Tem mã QR tra cứu</h6>
        <div class="p-2 border rounded bg-light d-inline-block mx-auto mb-2">
          <img src="{{qrCodeDataUrl}}" alt="QR Code" class="img-fluid" style="width: 150px; height: 150px;" />
        </div>
        <div class="fw-bold font-monospace text-dark fs-6">{{asset.code}}</div>
        <small class="text-muted mb-3 d-block">Quét mã bằng camera điện thoại để đối chiếu hoặc kiểm kê tài sản</small>
        <button onclick="window.print()" class="btn btn-secondary btn-sm w-100">
          In tem QR
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Bàn giao / Cấp phát tài sản cho nhân sự -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-0 shadow">
      <form action="/assets/{{asset.id}}/assign" method="POST">
        <div class="modal-header py-3 border-bottom">
          <h6 class="modal-title fw-bold text-dark" id="assignModalLabel">
            Bàn giao tài sản cho nhân sự
          </h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
        </div>
        <div class="modal-body p-3">
          <div class="mb-3">
            <label class="form-label text-muted small">Tài sản bàn giao:</label>
            <div class="p-2 bg-light border rounded fw-semibold text-dark">
              {{asset.code}} - {{asset.name}}
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Nhân viên tiếp nhận <span class="text-danger">*</span></label>
            <select name="assignee_id" class="form-select form-select-sm" required>
              <option value="">-- Chọn nhân viên tiếp nhận --</option>
              {{#each formData.users}}
                <option value="{{this.id}}">{{this.full_name}} ({{this.email}})</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Đơn vị quản lý mới</label>
            <select name="org_unit_id" class="form-select form-select-sm">
              <option value="">-- Giữ nguyên: {{asset.org_unit_name}} --</option>
              {{#each formData.orgUnits}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Vị trí bàn giao mới</label>
            <select name="location_id" class="form-select form-select-sm">
              <option value="">-- Chọn vị trí / phòng máy --</option>
              {{#each formData.locations}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Ghi chú bàn giao</label>
            <textarea name="note" class="form-control form-control-sm" rows="2" placeholder="Ghi chú tình trạng thiết bị khi bàn giao..."></textarea>
          </div>
        </div>
        <div class="modal-footer py-2 border-top">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
          <button type="submit" class="btn btn-sm btn-primary">Xác nhận bàn giao</button>
        </div>
      </form>
    </div>
  </div>
</div>
