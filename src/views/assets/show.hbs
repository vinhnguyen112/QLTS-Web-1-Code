<div class="container-fluid">
    <div class="mb-4">
        <h3 class="mb-1">Chi tiết tài sản</h3>
        <p class="text-secondary mb-0">
            Thông tin chi tiết của tài sản
        </p>
    </div>

    <div class="card">
        <div class="card-header">
            Thông tin tài sản
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Mã tài sản:</strong>
                    <div>{{asset.asset_code}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Tên tài sản:</strong>
                    <div>{{asset.asset_name}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Danh mục:</strong>
                    <div>{{asset.category_name}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Số serial:</strong>
                    <div>{{asset.serial_number}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Ngày mua:</strong>
                    <div>{{asset.purchase_date}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Giá trị:</strong>
                    <div>{{asset.original_cost}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Vị trí:</strong>
                    <div>{{asset.location}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Phòng ban:</strong>
                    <div>{{asset.department_name}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Người sử dụng:</strong>
                    <div>{{asset.full_name}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Trạng thái:</strong>
                    <div>{{asset.status}}</div>
                </div>
                <div class="col-12 mb-3">
                    <strong>Mô tả:</strong>
                    <div>{{asset.description}}</div>
                </div>
            </div>
            <div class="mt-3">
                <a href="/assets"
                   class="btn btn-secondary">
                    Quay lại
                </a>
                <a href="/assets/{{asset.asset_id}}/edit"
                   class="btn btn-warning">
                    Sửa tài sản
                </a>
            </div>
        </div>
    </div>
</div>