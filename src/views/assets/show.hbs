<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 text-dark">Hồ sơ tài sản: <span class="fw-bold">{{asset.asset_code}}</span></h4>
            <p class="text-secondary mb-0 small">
                Thông tin chi tiết và nhật ký vòng đời tài sản
            </p>
        </div>

        <div class="d-flex gap-2">
            <a href="/assets" class="btn btn-secondary btn-sm">
                Quay lại
            </a>
            <a href="/assets/{{asset.asset_id}}/edit" class="btn btn-warning btn-sm">
                Sửa
            </a>
        </div>
    </div>

    <div class="row g-4 mb-3">
        <!-- Thông tin chi tiết tài sản -->
        <div class="col-12">
            <div class="card border">
                <div class="card-header">
                    Thông số & Hiện trạng tài sản
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Tên tài sản:</span>
                            <strong class="fs-6">{{asset.asset_name}}</strong>
                        </div>
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Loại tài sản:</span>
                            <strong>{{asset.category_name}}</strong>
                        </div>

                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Nguyên giá:</span>
                            <span class="fw-bold">{{formatCurrency asset.original_cost}} đ</span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Thời gian khấu hao:</span>
                            <strong>{{asset.useful_life_months}} tháng</strong> ({{formatDate asset.purchase_date}})
                        </div>

                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Vị trí hiện tại:</span>
                            {{#if asset.location_name}}
                                <strong>{{asset.location_name}}</strong>
                                {{#if asset.department_name}}<span class="text-muted">({{asset.department_name}})</span>{{/if}}
                            {{else}}
                                <span class="text-muted">Chưa xác định</span>
                            {{/if}}
                        </div>
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Người đang sử dụng:</span>
                            {{#if asset.current_employee_name}}
                                <span class="badge bg-light text-dark border px-2 py-1">
                                    {{asset.current_employee_name}}
                                    {{#if asset.employee_phone}}<small>({{asset.employee_phone}})</small>{{/if}}
                                </span>
                            {{else}}
                                <span class="badge bg-light text-dark border">Trong kho - Chưa bàn giao</span>
                            {{/if}}
                        </div>

                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Nhà cung cấp:</span>
                            <div>{{#if asset.supplier_name}}<strong>{{asset.supplier_name}}</strong>{{else}}<span class="text-muted">-</span>{{/if}}</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <span class="text-muted d-block small">Trạng thái:</span>
                            <div>
                                {{#if (eq asset.status "in_use")}}
                                    <span class="badge bg-light text-dark border">Đang sử dụng</span>
                                {{else if (eq asset.status "in_stock")}}
                                    <span class="badge bg-light text-dark border">Trong kho</span>
                                {{else if (eq asset.status "maintenance")}}
                                    <span class="badge bg-light text-dark border">Đang bảo trì</span>
                                {{else if (eq asset.status "disposed")}}
                                    <span class="badge bg-light text-dark border">Đã thanh lý</span>
                                {{/if}}
                            </div>
                        </div>

                        <div class="col-12">
                            <span class="text-muted d-block small">Thông số kỹ thuật / Cấu hình:</span>
                            <div class="p-2 bg-light rounded small border">{{#if asset.specifications}}{{asset.specifications}}{{else}}Chưa có thông số chi tiết{{/if}}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
