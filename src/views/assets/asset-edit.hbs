<div class="container-fluid p-0">
  <div class="card border shadow-none">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 fw-bold text-dark">Chỉnh sửa hồ sơ tài sản: <span class="text-primary">{{asset.code}}</span></h5>
        <small class="text-muted">{{asset.name}}</small>
      </div>
      <a href="/assets/{{asset.id}}" class="btn btn-secondary btn-sm">
        Quay lại
      </a>
    </div>

    <form action="/assets/{{asset.id}}/update" method="POST">
      <div class="card-body">
        <h6 class="mb-3 text-primary fw-bold">1. Thông tin định danh</h6>
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Mã tài sản <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="code" value="{{asset.code}}" required />
          </div>

          <div class="col-md-5">
            <label class="form-label small fw-semibold">Tên tài sản <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="name" value="{{asset.name}}" required />
          </div>

          <div class="col-md-3">
            <label class="form-label small fw-semibold">Số Serial / Service Tag</label>
            <input type="text" class="form-control font-monospace" name="serial_no" value="{{asset.serial_no}}" />
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-semibold">Danh mục phân loại <span class="text-danger">*</span></label>
            <select class="form-select" name="category_id" required>
              <option value="">-- Chọn danh mục --</option>
              {{#each formData.categories}}
                <option value="{{this.id}}" {{#if (eq this.id ../asset.category_id)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-semibold">Đơn vị quản lý (Phòng ban) <span class="text-danger">*</span></label>
            <select class="form-select" name="org_unit_id" required>
              <option value="">-- Chọn phòng ban --</option>
              {{#each formData.orgUnits}}
                <option value="{{this.id}}" {{#if (eq this.id ../asset.org_unit_id)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-semibold">Vị trí lắp đặt</label>
            <select class="form-select" name="location_id">
              <option value="">-- Chọn vị trí / Kho --</option>
              {{#each formData.locations}}
                <option value="{{this.id}}" {{#if (eq this.id ../asset.location_id)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>
        </div>

        <h6 class="mb-3 text-primary fw-bold">2. Phân bổ & Trạng thái</h6>
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Người đang giữ / Sử dụng</label>
            <select class="form-select" name="assignee_id">
              <option value="">-- Trong kho (Chưa cấp phát) --</option>
              {{#each formData.users}}
                <option value="{{this.id}}" {{#if (eq this.id ../asset.assignee_id)}}selected{{/if}}>{{this.full_name}} ({{this.email}})</option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-semibold">Trạng thái vòng đời <span class="text-danger">*</span></label>
            <select class="form-select" name="status" required>
              <option value="in_stock" {{#if (eq asset.status "in_stock")}}selected{{/if}}>Trong kho (in_stock)</option>
              <option value="in_use" {{#if (eq asset.status "in_use")}}selected{{/if}}>Đang sử dụng (in_use)</option>
              <option value="maintenance" {{#if (eq asset.status "maintenance")}}selected{{/if}}>Đang bảo trì (maintenance)</option>
              <option value="transferring" {{#if (eq asset.status "transferring")}}selected{{/if}}>Đang điều chuyển (transferring)</option>
              <option value="disposed" {{#if (eq asset.status "disposed")}}selected{{/if}}>Đã thanh lý (disposed)</option>
              <option value="lost" {{#if (eq asset.status "lost")}}selected{{/if}}>Đã mất (lost)</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-semibold">Nhà cung cấp</label>
            <select class="form-select" name="supplier_id">
              <option value="">-- Chọn nhà cung cấp --</option>
              {{#each formData.suppliers}}
                <option value="{{this.id}}" {{#if (eq this.id ../asset.supplier_id)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>
        </div>

        <h6 class="mb-3 text-primary fw-bold">3. Giá trị & Khấu hao</h6>
        <div class="row g-3 mb-4">
          <div class="col-md-4">
            <label class="form-label small fw-semibold">Nguyên giá (VNĐ) <span class="text-danger">*</span></label>
            <input type="number" class="form-control" name="original_cost" value="{{asset.original_cost}}" min="0" required />
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-semibold">Ngày mua / Bắt đầu sử dụng <span class="text-danger">*</span></label>
            <input type="date" class="form-control" name="purchase_date" value="{{asset.purchase_date}}" required />
          </div>

          <div class="col-md-4">
            <label class="form-label small fw-semibold">Thời gian sử dụng / Khấu hao (Tháng) <span class="text-danger">*</span></label>
            <input type="number" class="form-control" name="useful_life_months" value="{{asset.useful_life_months}}" min="1" required />
          </div>
        </div>

        <div class="d-flex justify-content-end gap-2 border-top pt-3">
          <a href="/assets/{{asset.id}}" class="btn btn-secondary px-3">Hủy bỏ</a>
          <button type="submit" class="btn btn-primary px-4 fw-semibold">
            Lưu thay đổi
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
