<div class="container-fluid">
  <div class="card">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col">
          <h5 class="mb-0">Tài sản</h5>
          <small class="text-muted">Quản lý danh sách tài sản của doanh nghiệp</small>
        </div>

        <div class="col-auto d-flex align-items-center gap-2">
          <form action="" method="get" class="m-0" role="search">
            <div class="input-group">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm tên tài sản..."
              />
              <button class="btn btn-secondary" type="submit">Lọc</button>
            </div>
          </form>
          <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addAssetModal"
          >Thêm tài sản</button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>STT</th>
            <th>Mã tài sản</th>
            <th>Tên tài sản</th>
            <th>Danh mục</th>
            <th>Phòng ban</th>
            <th>Nguyên giá</th>
            <th>Trạng thái</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each assets}}
            <tr>
              <td>{{addOne @index}}</td>
              <td>{{this.asset_code}}</td>
              <td>{{this.asset_name}}</td>
              <td>{{this.category_name}}</td>
              <td>{{this.department_name}}</td>
              <td>{{formatCurrency this.original_cost}} VNĐ</td>
              <td>
                {{#if (eq this.status "in_use")}}
                  <span class="badge bg-success">Đang sử dụng</span>
                {{else if (eq this.status "in_stock")}}
                  <span class="badge bg-secondary">Trong kho</span>
                {{else if (eq this.status "maintenance")}}
                  <span class="badge bg-warning text-dark">Đang bảo trì</span>
                {{/if}}
              </td>
              <td>
                <div class="d-flex justify-content-center gap-1">
                  <a href="/assets/{{this.asset_id}}"class="btn btn-sm btn-info">Xem</a>
                  <a href="/assets/{{this.asset_id}}/edit" class="btn btn-sm btn-warning">Sửa</a>
                  <form
                    action="/assets/{{this.asset_id}}/delete"
                    method="POST"
                    class="m-0"
                    onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài sản này không?');"
                  >
                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<div class="modal fade" id="addAssetModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      {{> asset-create}}
    </div>
  </div>
</div>