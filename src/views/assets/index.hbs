<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h3 class="mb-1">Tài sản</h3>
      <p class="text-secondary mb-0">
        Quản lý danh sách tài sản của doanh nghiệp
      </p>
    </div>

    <a href="/assets/create" class="btn btn-primary">
      Thêm tài sản
    </a>
  </div>

  <div class="card mb-4">
    <div class="card-body">
      <div class="row g-3">
        <div class="col-md-5">
          <label class="form-label">
            Tìm kiếm
          </label>
          <input
            type="text"
            class="form-control"
            placeholder="Mã tài sản hoặc tên tài sản..."
          />
        </div>
        <div class="col-md-3">
          <label class="form-label">
            Danh mục
          </label>
          <select class="form-select">
            <option selected>
              Tất cả danh mục
            </option>
            <option>
              Máy tính
            </option>
            <option>
              Máy in
            </option>
            <option>
              Thiết bị văn phòng
            </option>
          </select>
        </div>

        <div class="col-md-3">
          <label class="form-label">
            Trạng thái
          </label>
          <select class="form-select">
            <option selected>
              Tất cả trạng thái
            </option>

            <option>
              Đang sử dụng
            </option>

            <option>
              Trong kho
            </option>

            <option>
              Đang bảo trì
            </option>

          </select>
        </div>

        <div class="col-md-1 d-flex align-items-end">
          <button class="btn btn-secondary w-100">
            Lọc
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Danh sách tài sản -->
  <div class="card">
    <div class="card-header bg-white">
      <strong>
        Danh sách tài sản
      </strong>
    </div>

    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>STT</th>
            <th>Mã tài sản</th>
            <th>Tên tài sản</th>
            <th>Danh mục</th>
            <th>Phòng ban</th>
            <th>Nguyên giá</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each assets}}
            <tr>
              <td>
                {{addOne @index}}
              </td>
              <td>
                {{this.asset_code}}
              </td>
              <td>
                {{this.asset_name}}
              </td>
              <td>
                {{this.category_name}}
              </td>
              <td>
                {{this.department_name}}
              </td>
              <td>
                {{formatCurrency original_cost}}
                VNĐ
              </td>
              <td>
                {{#if (eq this.status "in_use")}}
                  <span class="badge text-bg-success">
                    Đang sử dụng
                  </span>
                {{else if (eq this.status "in_stock")}}
                  <span class="badge text-bg-secondary">
                    Trong kho
                  </span>
                {{else if (eq this.status "maintenance")}}
                  <span class="badge text-bg-warning">
                    Đang bảo trì
                  </span>
                {{/if}}
              </td>
              <td>
                <a
                  href="/assets/{{this.asset_id}}/edit"
                  class="btn btn-sm btn-warning"
                >
                  Sửa
                </a>

                <form
                  action="/assets/{{this.asset_id}}/delete"
                  method="POST"
                  style="display: inline;"
                  onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài sản này không?');"
                >
                  <button type="submit" class="btn btn-sm btn-danger">
                    Xóa
                  </button>
                </form>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>