<div class="container-fluid p-0">
  <div class="card">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-5">
          <h5 class="mb-0 fw-bold text-dark">Kho thiết bị & Tài sản</h5>
          <small class="text-muted">Danh sách tài sản đang lưu kho sẵn sàng điều phối hoặc cấp phát</small>
        </div>

        <div class="col-md-7 d-flex flex-wrap justify-content-md-end align-items-center gap-2">
          <form action="/warehouse" method="get" class="m-0" role="search">
            <div class="input-group input-group-sm" style="width: 240px;">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Mã hoặc tên tài sản..."
              />
              <button class="btn btn-primary" type="submit">Tìm</button>
            </div>
          </form>

          <!-- Chỉ Quản lý tài sản hoặc Admin mới có nút Nhập kho -->
          {{#if canManageAssets}}
          <button
            type="button"
            class="btn btn-sm btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addWarehouseModal"
          >
            Nhập tài sản vào kho
          </button>
          {{/if}}
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3">#</th>
            <th scope="col">Mã tài sản</th>
            <th scope="col">Tên tài sản</th>
            <th scope="col">Danh mục</th>
            <th scope="col">Đơn vị lưu trữ</th>
            <th scope="col">Vị trí kho</th>
            <th scope="col">Nguyên giá</th>
            <th scope="col" class="text-end pe-3">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each assets}}
            <tr>
              <td class="ps-3 text-muted">{{addOne @index}}</td>
              <td class="fw-semibold text-dark">{{this.code}}</td>
              <td>{{this.name}}</td>
              <td><span class="badge text-bg-light border">{{this.category_name}}</span></td>
              <td>{{this.org_unit_name}}</td>
              <td>{{#if this.location_name}}{{this.location_name}}{{else}}<span class="text-muted">Kho tổng</span>{{/if}}</td>
              <td class="text-dark">{{formatCurrency this.original_cost}}</td>
              <td class="text-end pe-3">
                <div class="btn-group btn-group-sm" role="group">
                  <!-- Chỉ Quản lý tài sản hoặc Admin mới có nút Cấp phát -->
                  {{#if ../canManageAssets}}
                  <button
                    type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#assignModal"
                    data-id="{{this.id}}"
                    data-name="{{this.name}}"
                    data-code="{{this.code}}"
                  >
                    Cấp phát
                  </button>
                  {{/if}}
                  <a href="/assets/{{this.id}}" class="btn btn-secondary">
                    Chi tiết
                  </a>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center py-4 text-muted">Hiện không có tài sản nào đang lưu trong kho</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Phân trang Bootstrap 5 chuẩn -->
    {{#if (gt totalPages 1)}}
      <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
        <div class="small text-muted">Trang <b>{{page}}</b> / {{totalPages}}</div>
        <nav aria-label="Phân trang">
          <ul class="pagination pagination-sm mb-0">
            {{#each pages}}
              <li class="page-item {{#if this.active}}active{{/if}}">
                <a class="page-link" href="/warehouse?page={{this.number}}&name={{../searchName}}">
                  {{this.number}}
                </a>
              </li>
            {{/each}}
          </ul>
        </nav>
      </div>
    {{/if}}
  </div>
</div>

<!-- Modal 1: Cấp phát tài sản -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/warehouse/assign" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fs-6 fw-bold text-dark" id="assignModalLabel">Cấp phát tài sản</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" name="asset_id" id="modal_asset_id">
          
          <div class="mb-3">
            <label class="form-label text-muted small">Tài sản cấp phát:</label>
            <input type="text" class="form-control" id="modal_asset_display" readonly disabled>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Người tiếp nhận <span class="text-danger">*</span></label>
            <select name="assignee_id" class="form-select" required>
              <option value="">-- Chọn nhân viên tiếp nhận --</option>
              {{#each formData.users}}
                <option value="{{this.id}}">{{this.full_name}} ({{this.email}})</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Đơn vị quản lý mới</label>
            <select name="org_unit_id" class="form-select">
              <option value="">-- Giữ nguyên đơn vị hiện tại --</option>
              {{#each formData.orgUnits}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Vị trí bàn giao</label>
            <select name="location_id" class="form-select">
              <option value="">-- Chọn vị trí / phòng máy --</option>
              {{#each formData.locations}}
                <option value="{{this.id}}">{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold">Ghi chú cấp phát</label>
            <textarea name="note" class="form-control" rows="2" placeholder="Ghi chú bàn giao..."></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Hủy</button>
          <button type="submit" class="btn btn-sm btn-primary">Xác nhận cấp phát</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Modal 2: Nhập mới tài sản vào kho -->
<div class="modal fade" id="addWarehouseModal" tabindex="-1" aria-labelledby="addWarehouseModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form action="/warehouse" method="POST">
        <div class="modal-header">
          <h5 class="modal-title fs-6 fw-bold text-dark" id="addWarehouseModalLabel">Nhập mới tài sản vào kho</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Mã tài sản</label>
              <input type="text" name="code" class="form-control" placeholder="Để trống nếu sinh tự động">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Tên tài sản <span class="text-danger">*</span></label>
              <input type="text" name="name" class="form-control" placeholder="Ví dụ: Dell Latitude 5540" required>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold">Danh mục <span class="text-danger">*</span></label>
              <select name="category_id" class="form-select" required>
                <option value="">-- Chọn danh mục --</option>
                {{#each formData.categories}}
                  <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Nhà cung cấp</label>
              <select name="supplier_id" class="form-select">
                <option value="">-- Chọn nhà cung cấp --</option>
                {{#each formData.suppliers}}
                  <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
              </select>
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold">Nguyên giá (VNĐ) <span class="text-danger">*</span></label>
              <input type="number" name="original_cost" class="form-control" placeholder="0" required>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Ngày mua</label>
              <input type="date" name="purchase_date" class="form-control">
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold">Thời gian sử dụng (tháng)</label>
              <input type="number" name="useful_life_months" class="form-control" value="36">
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Số Serial / Service Tag</label>
              <input type="text" name="serial_no" class="form-control">
            </div>

            <div class="col-md-6">
              <label class="form-label small fw-semibold">Đơn vị quản lý</label>
              <select name="org_unit_id" class="form-select">
                {{#each formData.orgUnits}}
                  <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label small fw-semibold">Vị trí lưu kho</label>
              <select name="location_id" class="form-select">
                <option value="">-- Kho mặc định --</option>
                {{#each formData.locations}}
                  <option value="{{this.id}}">{{this.name}}</option>
                {{/each}}
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Đóng</button>
          <button type="submit" class="btn btn-sm btn-primary">Lưu vào kho</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Gắn thông tin tài sản vào modal cấp phát khi click
  const assignModal = document.getElementById('assignModal');
  if (assignModal) {
    assignModal.addEventListener('show.bs.modal', function (event) {
      const button = event.relatedTarget;
      const assetId = button.getAttribute('data-id');
      const assetName = button.getAttribute('data-name');
      const assetCode = button.getAttribute('data-code');

      document.getElementById('modal_asset_id').value = assetId;
      document.getElementById('modal_asset_display').value = `${assetCode} - ${assetName}`;
    });
  }
</script>
