<div class="container-fluid p-0">
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <h4 class="mb-1 text-dark fw-bold">Tổng quan hệ thống</h4>
      <p class="text-muted mb-0 small">Thống kê hiện trạng tài sản toàn đơn vị</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/requests/create" class="btn btn-primary btn-sm">
        Tạo yêu cầu
      </a>
      <a href="/assets?status=in_stock" class="btn btn-secondary btn-sm">
        Kho tài sản
      </a>
    </div>
  </div>

  <!-- Thẻ thống kê tối giản (Click để lọc nhanh danh sách) -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
      <a href="/assets" class="text-decoration-none">
        <div class="card h-100 border hover-shadow">
          <div class="card-body">
            <div class="text-muted small">Tổng tài sản</div>
            <div class="fs-4 fw-bold text-dark mt-1">{{totals.totalAssets}}</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-sm-6 col-md-3">
      <a href="/assets?status=in_use" class="text-decoration-none">
        <div class="card h-100 border hover-shadow">
          <div class="card-body">
            <div class="text-muted small">Đang sử dụng</div>
            <div class="fs-4 fw-bold text-success mt-1">{{totals.inUse}}</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-sm-6 col-md-3">
      <a href="/assets?status=in_stock" class="text-decoration-none">
        <div class="card h-100 border hover-shadow">
          <div class="card-body">
            <div class="text-muted small">Trong kho (Lưu trữ)</div>
            <div class="fs-4 fw-bold text-primary mt-1">{{totals.inStock}}</div>
          </div>
        </div>
      </a>
    </div>
    <div class="col-sm-6 col-md-3">
      <a href="/assets?status=maintenance" class="text-decoration-none">
        <div class="card h-100 border hover-shadow">
          <div class="card-body">
            <div class="text-muted small">Đang sửa chữa / Bảo trì</div>
            <!-- Chỉ đổi màu cảnh báo khi có sự cố cần lưu ý -->
            <div class="fs-4 fw-bold {{#if (gt totals.maintenance 0)}}text-danger{{else}}text-dark{{/if}} mt-1">
              {{totals.maintenance}}
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>

  <!-- Biểu đồ phân tích trực quan -->
  <div class="row g-3 mb-4">
    <div class="col-lg-8">
      <div class="card border shadow-none h-100">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-bold text-dark">Phân bổ tài sản theo phòng ban</h6>
        </div>
        <div class="card-body p-3">
          <div style="height: 260px;">
            <canvas id="deptChart"></canvas>
          </div>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border shadow-none h-100">
        <div class="card-header bg-white py-3 border-bottom">
          <h6 class="mb-0 fw-bold text-dark">Cơ cấu theo danh mục</h6>
        </div>
        <div class="card-body p-3">
          <div style="height: 260px;">
            <canvas id="catChart"></canvas>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bảng tài sản mới cập nhật -->
  <div class="card mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
      <span class="fw-bold text-dark">Tài sản mới cập nhật gần đây</span>
      <a href="/assets" class="small text-decoration-none">Xem tất cả</a>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3">#</th>
            <th scope="col">Mã tài sản</th>
            <th scope="col">Tên tài sản</th>
            <th scope="col">Danh mục</th>
            <th scope="col">Đơn vị quản lý</th>
            <th scope="col">Nguyên giá</th>
            <th scope="col">Trạng thái</th>
            <th scope="col" class="text-end pe-3">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each recentAssets}}
            <tr>
              <td class="ps-3 text-muted">{{addOne @index}}</td>
              <td class="fw-semibold text-dark">{{this.code}}</td>
              <td>{{this.name}}</td>
              <td><span class="badge text-bg-light border">{{this.category_name}}</span></td>
              <td>{{this.org_unit_name}}</td>
              <td class="text-dark">{{formatCurrency this.original_cost}}</td>
              <td>{{{assetStatusBadge this.status}}}</td>
              <td class="text-end pe-3 text-nowrap">
                <div class="d-inline-flex gap-1">
                  <a href="/assets/{{this.id}}" class="btn btn-primary text-nowrap">Chi tiết</a>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center py-4 text-muted">Chưa có tài sản nào</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function () {
    try {
      const deptLabels = {{{deptLabels}}};
      const deptData = {{{deptData}}};
      const catLabels = {{{catLabels}}};
      const catData = {{{catData}}};

      if (document.getElementById('deptChart')) {
        new Chart(document.getElementById('deptChart'), {
          type: 'bar',
          data: {
            labels: deptLabels,
            datasets: [{
              label: 'Số lượng tài sản',
              data: deptData,
              backgroundColor: '#0d6efd',
              borderRadius: 4,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { beginAtZero: true, ticks: { precision: 0 } },
              x: { grid: { display: false } }
            }
          }
        });
      }

      if (document.getElementById('catChart')) {
        new Chart(document.getElementById('catChart'), {
          type: 'doughnut',
          data: {
            labels: catLabels,
            datasets: [{
              data: catData,
              backgroundColor: ['#0d6efd', '#20c997', '#ffc107', '#fd7e14', '#6c757d', '#6610f2'],
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
              legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } }
            }
          }
        });
      }
    } catch (e) {
      console.warn('Lỗi vẽ biểu đồ Dashboard:', e);
    }
  });
</script>
