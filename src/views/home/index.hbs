<div class="container-fluid p-0">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h4 class="mb-1 text-dark">Tổng quan hệ thống</h4>
      <p class="text-muted mb-0 small">Báo cáo số lượng và giá trị tài sản đang quản lý</p>
    </div>
    <div>
      <a href="/reports" class="btn btn-outline-secondary btn-sm">Xem chi tiết báo cáo</a>
    </div>
  </div>

  <!-- Bảng 1: Bảng tổng hợp hiện trạng tài sản -->
  <div class="card mb-3">
    <div class="card-header">
      1. Bảng tổng hợp hiện trạng tài sản toàn công ty
    </div>
    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">STT</th>
            <th>Trạng thái tài sản</th>
            <th class="text-center" style="width: 160px;">Số lượng</th>
            <th class="text-center" style="width: 140px;">Tỷ trọng</th>
            <th>Mô tả hiện trạng</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="text-center">1</td>
            <td><strong>Đang sử dụng</strong></td>
            <td class="text-center fw-semibold">{{inUse}}</td>
            <td class="text-center">{{inUsePercent}}%</td>
            <td class="text-muted small">Đã bàn giao cụ thể cho nhân viên hoặc phòng ban sử dụng</td>
          </tr>
          <tr>
            <td class="text-center">2</td>
            <td><strong>Trong kho</strong></td>
            <td class="text-center fw-semibold">{{inStock}}</td>
            <td class="text-center">{{inStockPercent}}%</td>
            <td class="text-muted small">Lưu trữ tại các kho, sẵn sàng để cấp phát hoặc điều chuyển</td>
          </tr>
          <tr>
            <td class="text-center">3</td>
            <td><strong>Đang bảo trì</strong></td>
            <td class="text-center fw-semibold">{{maintenance}}</td>
            <td class="text-center">{{maintenancePercent}}%</td>
            <td class="text-muted small">Thiết bị đang gửi đi bảo hành, sửa chữa kỹ thuật</td>
          </tr>
        </tbody>
        <tfoot class="table-light">
          <tr class="fw-bold">
            <td colspan="2" class="text-end">TỔNG CỘNG:</td>
            <td class="text-center">{{totalAssets}} tài sản</td>
            <td class="text-center">100%</td>
            <td>Tổng giá trị nguyên giá: <strong>{{formatCurrency totalCost}}</strong> đ</td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- Bảng 2: Bảng phân bổ tài sản theo phòng ban -->
  <div class="card">
    <div class="card-header">
      2. Bảng phân bổ tài sản theo phòng ban
    </div>
    <div class="table-responsive">
      <table class="table table-bordered table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width: 50px;" class="text-center">STT</th>
            <th>Phòng ban</th>
            <th class="text-center" style="width: 180px;">Số lượng tài sản</th>
            <th class="text-end" style="width: 220px;">Tổng nguyên giá (VNĐ)</th>
          </tr>
        </thead>
        <tbody>
          {{#each byDepartment}}
            <tr>
              <td class="text-center">{{addOne @index}}</td>
              <td>{{this.department_name}}</td>
              <td class="text-center">{{this.total_assets}}</td>
              <td class="text-end">{{formatCurrency this.total_cost}} đ</td>
            </tr>
          {{else}}
            <tr>
              <td colspan="4" class="text-center text-muted py-3">Chưa có dữ liệu</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>