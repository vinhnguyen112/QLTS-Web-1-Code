<header class="navbar-top d-flex align-items-center">
  <div class="container-fluid px-3">
    <div class="d-flex justify-content-between align-items-center">
      <div class="d-flex align-items-center">
        <!-- Nút mở offcanvas sidebar với body scrolling -->
        <button
          class="btn btn-sm btn-outline-secondary me-3"
          type="button"
          data-bs-toggle="offcanvas"
          data-bs-target="#offcanvasScrolling"
          aria-controls="offcanvasScrolling"
        >
          Menu
        </button>

        <div>
          <span class="fs-6 fw-bold text-dark text-uppercase">
            Quản Lý Tài Sản
          </span>
          <span class="text-muted small ms-2 d-none d-sm-inline">
            | Hệ thống quản lý tài sản doanh nghiệp
          </span>
        </div>
      </div>

      <div class="d-flex align-items-center">
        <div class="dropdown">
          <button
            class="btn btn-outline-secondary dropdown-toggle btn-sm"
            type="button"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            Quản trị viên
          </button>

          <ul class="dropdown-menu dropdown-menu-end">
            <li><h6 class="dropdown-header">Tài khoản</h6></li>
            <li><a class="dropdown-item" href="#">Thông tin cá nhân</a></li>
            <li><a class="dropdown-item" href="#">Đổi mật khẩu</a></li>
            <li><hr class="dropdown-divider" /></li>
            <li><a class="dropdown-item" href="#">Đăng xuất</a></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</header>