<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <!-- Bootswatch Flatly (Bootstrap 5.3) - Chủ đề phẳng, dịu mắt cho Quản lý tài sản -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/flatly/bootstrap.min.css">
    <!-- Bootstrap Icons (gọn nhẹ, chuẩn Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    {{> header}}

    <!-- Offcanvas Sidebar -->
    <div
      class="offcanvas offcanvas-start"
      data-bs-scroll="true"
      data-bs-backdrop="false"
      tabindex="-1"
      id="offcanvasScrolling"
      aria-labelledby="offcanvasScrollingLabel"
      style="width: 260px;"
    >
      <div class="offcanvas-header border-bottom py-2 px-3">
        <div class="d-flex align-items-center">
          <span class="badge bg-primary text-white me-2 py-1 px-2 fw-bold" style="font-size: 0.85rem;">TS</span>
          <span class="fw-bold text-dark mb-0 fs-6">QLTS Doanh Nghiệp</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body p-0">
        {{> sidebar}}
      </div>
    </div>

    <!-- Main Content -->
    <main class="main-wrapper">
        {{{body}}}
    </main>

    <!-- Bootswatch Flatly Toast Notifications -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1090;">
      {{#if (or errorMessage error)}}
      <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
          <strong class="me-auto text-danger"><i class="bi bi-exclamation-circle-fill me-1"></i> Thông báo lỗi</strong>
          <small class="text-muted">Hệ thống</small>
          <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
          {{or errorMessage error}}
        </div>
      </div>
      {{/if}}

      {{#if (or successMessage msg)}}
      <div class="toast show" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
          <strong class="me-auto text-success"><i class="bi bi-check-circle-fill me-1"></i> Thành công</strong>
          <small class="text-muted">Hệ thống</small>
          <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
          {{or successMessage msg}}
        </div>
      </div>
      {{/if}}
    </div>

    {{> footer}}

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      document.querySelectorAll('.toast').forEach(function(el) {
        var t = new bootstrap.Toast(el, { delay: 4000 });
        t.show();
      });
    </script>
</body>
</html>
