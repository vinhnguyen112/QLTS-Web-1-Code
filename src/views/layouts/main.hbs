<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <!-- Bootswatch Flatly (Bootstrap 5.3) - Chủ đề phẳng, dịu mắt cho Quản lý tài sản -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/flatly/bootstrap.min.css">
    <!-- Bootstrap Icons (gọn nhẹ, chuẩn Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    {{> header}}

    <!-- Offcanvas Sidebar -->
    <div
      class="offcanvas offcanvas-start"
      data-bs-scroll="true"
      data-bs-backdrop="false"
      tabindex="-1"
      id="offcanvasScrolling"
      aria-labelledby="offcanvasScrollingLabel"
      style="width: 260px;"
    >
      <div class="offcanvas-header border-bottom py-2 px-3">
        <div class="d-flex align-items-center">
          <span class="badge bg-primary text-white me-2 py-1 px-2 fw-bold" style="font-size: 0.85rem;">TS</span>
          <span class="fw-bold text-dark mb-0 fs-6">QLTS Doanh Nghiệp</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body p-0">
        {{> sidebar}}
      </div>
    </div>

    <!-- Main Content -->
    <main class="main-wrapper">
        {{{body}}}
    </main>

    {{> footer}}

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
      (function() {
        const errorMsg = {{{json (or errorMessage error)}}};
        const successMsg = {{{json (or successMessage msg)}}};

        if (errorMsg || successMsg) {
          const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 3500,
            timerProgressBar: true,
            didOpen: (toast) => {
              toast.onmouseenter = Swal.stopTimer;
              toast.onmouseleave = Swal.resumeTimer;
            }
          });

          if (errorMsg) {
            Toast.fire({
              icon: 'error',
              title: errorMsg
            });
          } else if (successMsg) {
            Toast.fire({
              icon: 'success',
              title: successMsg
            });
          }
        }
      })();
    </script>
</body>
</html>
