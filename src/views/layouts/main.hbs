<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <!-- Bootswatch Flatly (Bootstrap 5.3) - Chủ đề phẳng, dịu mắt cho Quản lý tài sản -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.3/dist/flatly/bootstrap.min.css">
    <!-- Bootstrap Icons (gọn nhẹ, chuẩn Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    {{> header}}

    <!-- Offcanvas Sidebar -->
    <div
      class="offcanvas offcanvas-start"
      data-bs-scroll="true"
      data-bs-backdrop="false"
      tabindex="-1"
      id="offcanvasScrolling"
      aria-labelledby="offcanvasScrollingLabel"
      style="width: 260px;"
    >
      <div class="offcanvas-header border-bottom py-2 px-3">
        <div class="d-flex align-items-center">
          <span class="badge bg-primary text-white me-2 py-1 px-2 fw-bold" style="font-size: 0.85rem;">TS</span>
          <span class="fw-bold text-dark mb-0 fs-6">QLTS Doanh Nghiệp</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
      </div>
      <div class="offcanvas-body p-0">
        {{> sidebar}}
      </div>
    </div>

    <!-- Main Content -->
    <main class="main-wrapper">
        {{{body}}}
    </main>

    {{> footer}}

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
      // 1. Khởi tạo Toast dùng chung theo chuẩn SweetAlert2
      const Toast = Swal.mixin({
        toast: true,
        position: "top-end",
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
      });

      // 2. Hàm xác nhận hành động toàn hệ thống
      function confirmAction(e, message, title = "Bạn có chắc chắn?") {
        e.preventDefault();
        const form = e.target.closest("form") || e.target;
        Swal.fire({
          title: title,
          text: message || "Hành động này sẽ được thực hiện ngay lập tức!",
          icon: "warning",
          showCancelButton: true,
          confirmButtonColor: "#d33",
          cancelButtonColor: "#6c757d",
          confirmButtonText: "Đồng ý",
          cancelButtonText: "Hủy bỏ"
        }).then((result) => {
          if (result.isConfirmed) {
            form.submit();
          }
        });
      }

      // 3. Tự động bắt mọi form có thuộc tính data-confirm
      document.addEventListener("submit", function (e) {
        const form = e.target;
        const msg = form.getAttribute("data-confirm");
        if (msg && !form.dataset.confirmed) {
          e.preventDefault();
          const title = form.getAttribute("data-title") || "Bạn có chắc chắn?";
          const isDanger = form.getAttribute("data-danger") !== "false";
          Swal.fire({
            title: title,
            text: msg,
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: isDanger ? "#d33" : "#198754",
            cancelButtonColor: "#6c757d",
            confirmButtonText: "Đồng ý",
            cancelButtonText: "Hủy bỏ"
          }).then((result) => {
            if (result.isConfirmed) {
              form.dataset.confirmed = "true";
              form.submit();
            }
          });
        }
      });
    </script>

    {{#if (or errorMessage error)}}
    <script>
      Toast.fire({
        icon: "error",
        title: {{{json (or errorMessage error)}}}
      });
    </script>
    {{/if}}

    {{#if (or successMessage msg)}}
    <script>
      Toast.fire({
        icon: "success",
        title: {{{json (or successMessage msg)}}}
      });
    </script>
    {{/if}}
</body>
</html>
