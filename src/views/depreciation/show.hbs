<div class="container-fluid p-0">
  <!-- Thanh điều hướng và nút thao tác -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div class="d-flex align-items-center gap-2">
      <a href="/depreciation" class="btn btn-secondary btn-sm text-nowrap">
        Quay lại
      </a>
      <div>
        <h5 class="mb-0 fw-bold text-dark">Chi tiết khấu hao: {{asset.code}}</h5>
        <small class="text-muted">{{asset.name}}</small>
      </div>
    </div>
    <div class="d-flex gap-2">
      <a href="/assets/{{asset.id}}" class="btn btn-primary btn-sm text-nowrap">
        Hồ sơ tài sản
      </a>
    </div>
  </div>

  <!-- Khối 1: Thông tin tài sản & Chỉ số khấu hao cốt lõi -->
  <div class="card border shadow-none mb-3">
    <div class="card-body p-3">
      <div class="row g-3">
        <!-- Thông tin cơ bản -->
        <div class="col-lg-6">
          <table class="table table-sm table-borderless mb-0">
            <tbody>
              <tr>
                <td class="text-muted text-nowrap" style="width: 140px;">Mã tài sản:</td>
                <td class="fw-bold font-monospace text-dark">{{asset.code}}</td>
              </tr>
              <tr>
                <td class="text-muted text-nowrap">Tên tài sản:</td>
                <td class="fw-semibold text-dark">{{asset.name}}</td>
              </tr>
              <tr>
                <td class="text-muted text-nowrap">Đơn vị quản lý:</td>
                <td class="text-dark">{{asset.org_unit_name}}</td>
              </tr>
              <tr>
                <td class="text-muted text-nowrap">Loại tài sản:</td>
                <td class="text-dark">{{asset.category_name}}</td>
              </tr>
              <tr>
                <td class="text-muted text-nowrap">Ngày mua:</td>
                <td class="text-dark">{{formatDate asset.purchase_date}}</td>
              </tr>
              <tr>
                <td class="text-muted text-nowrap">Bắt đầu trích:</td>
                <td class="text-dark">{{formatDate asset.depreciation_start}}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- 4 Thẻ chỉ số tài chính -->
        <div class="col-lg-6">
          <div class="row g-2">
            <div class="col-6">
              <div class="p-3 border rounded bg-light">
                <small class="text-muted d-block">Nguyên giá tài sản</small>
                <div class="fw-bold text-dark mt-1">{{formatCurrency asset.original_cost}}</div>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 border rounded bg-light">
                <small class="text-muted d-block">Thời gian sử dụng</small>
                <div class="fw-bold text-dark mt-1">
                  {{#if asset.useful_life_months}}
                    {{asset.useful_life_months}} tháng
                    <small class="text-muted fw-normal d-block">({{formatCurrency dep.monthly}}/tháng)</small>
                  {{else}}
                    <span class="text-muted">Chưa thiết lập</span>
                  {{/if}}
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 border rounded bg-light">
                <small class="text-muted d-block">Hao mòn lũy kế</small>
                <div class="fw-bold text-danger mt-1">
                  {{formatCurrency dep.accumulated}}
                  <small class="text-muted fw-normal d-block">Đã trích {{dep.percent}}%</small>
                </div>
              </div>
            </div>
            <div class="col-6">
              <div class="p-3 border rounded bg-light">
                <small class="text-muted d-block">Giá trị còn lại</small>
                <div class="fw-bold text-success mt-1">
                  {{formatCurrency dep.remainingValue}}
                  <small class="text-muted fw-normal d-block">
                    {{#if dep.isDone}}Đã trích hết{{else}}Còn {{dep.remainingMonths}} tháng{{/if}}
                  </small>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Khối 2: Bảng phân bổ khấu hao từng tháng -->
  <div class="card border shadow-none">
    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
      <h6 class="mb-0 fw-bold text-dark">Kế hoạch trích khấu hao từng tháng</h6>
      <small class="text-muted">Phương pháp đường thẳng (VAS / TT 45/2013/TT-BTC)</small>
    </div>

    <div class="table-responsive" style="max-height: 480px;">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light sticky-top">
          <tr>
            <th scope="col" class="ps-3 text-nowrap">Kỳ</th>
            <th scope="col" class="text-nowrap">Tháng trích</th>
            <th scope="col" class="text-end text-nowrap">Mức trích kỳ này</th>
            <th scope="col" class="text-end text-nowrap">Hao mòn lũy kế</th>
            <th scope="col" class="text-end text-nowrap">Giá trị còn lại</th>
            <th scope="col" class="text-center text-nowrap pe-3">Trạng thái</th>
          </tr>
        </thead>
        <tbody>
          {{#each schedule}}
            <tr class="{{#if this.isCurrent}}table-primary fw-semibold{{/if}}">
              <td class="ps-3 text-muted">{{this.index}}</td>
              <td class="font-monospace text-dark">{{this.period}}</td>
              <td class="text-end text-dark">{{formatCurrency this.amount}}</td>
              <td class="text-end text-dark">{{formatCurrency this.accumulated}}</td>
              <td class="text-end text-success fw-bold">{{formatCurrency this.remaining}}</td>
              <td class="text-center pe-3 text-nowrap">
                {{#if this.isCurrent}}
                  <span class="badge text-bg-primary">Kỳ hiện tại</span>
                {{else if this.isPast}}
                  <span class="badge text-bg-success">Đã trích</span>
                {{else}}
                  <span class="badge text-bg-light border text-muted">Dự kiến</span>
                {{/if}}
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="6" class="text-center py-5 text-muted">
                Tài sản này chưa thiết lập thời gian sử dụng hữu ích.
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
