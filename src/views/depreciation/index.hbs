<div class="container-fluid p-0">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <div>
      <h5 class="mb-0 fw-bold text-dark">Khấu hao tài sản</h5>
      <small class="text-muted">Theo dõi phân bổ khấu hao đường thẳng và giá trị còn lại của tài sản</small>
    </div>
    <button onclick="window.print()" class="btn btn-secondary btn-sm">
      In bảng kê
    </button>
  </div>

  <!-- 3 Thẻ số liệu tài chính cốt lõi -->
  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <div class="card p-3 border shadow-none bg-white">
        <small class="text-muted d-block">Tổng nguyên giá tài sản</small>
        <div class="fs-5 fw-bold text-dark mt-1">{{formatCurrency summary.totalCost}}</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3 border shadow-none bg-white">
        <small class="text-muted d-block">Đã trích khấu hao (Hao mòn lũy kế)</small>
        <div class="fs-5 fw-bold text-dark mt-1">{{formatCurrency summary.totalAccumulated}}</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3 border shadow-none bg-white">
        <small class="text-muted d-block">Giá trị còn lại hiện tại</small>
        <div class="fs-5 fw-bold text-success mt-1">{{formatCurrency summary.totalRemaining}}</div>
      </div>
    </div>
  </div>

  <div class="card border shadow-none">
    <!-- Bộ lọc tối giản -->
    <div class="card-header bg-white py-3 border-0">
      <form action="/depreciation" method="get" class="d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <div class="input-group input-group-sm" style="max-width: 320px;">
          <input
            type="text"
            name="search"
            class="form-control"
            value="{{search}}"
            placeholder="Tìm theo mã hoặc tên tài sản..."
          />
          <button class="btn btn-primary" type="submit">Tìm</button>
        </div>

        <div class="d-flex gap-2">
          <select name="org_unit_id" class="form-select form-select-sm" style="width: 240px;" onchange="this.form.submit()">
            <option value="">Tất cả đơn vị</option>
            {{#each orgUnits}}
              <option value="{{this.id}}" {{#if (eq this.id ../orgUnitId)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </select>
          {{#if (or search orgUnitId)}}
            <a href="/depreciation" class="btn btn-secondary btn-sm text-nowrap">Đặt lại</a>
          {{/if}}
        </div>
      </form>
    </div>

    <!-- Bảng danh sách tinh gọn -->
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3 text-nowrap">#</th>
            <th scope="col" class="text-nowrap">Mã tài sản</th>
            <th scope="col">Tên tài sản</th>
            <th scope="col">Đơn vị quản lý</th>
            <th scope="col" class="text-end text-nowrap">Nguyên giá</th>
            <th scope="col" class="text-end text-nowrap">Khấu hao / Tháng</th>
            <th scope="col" class="text-end text-nowrap">Giá trị còn lại</th>
            <th scope="col" class="text-end pe-3 text-nowrap">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each assets}}
            <tr>
              <td class="ps-3 text-muted">{{addOne @index}}</td>
              <td class="fw-bold font-monospace">
                <a href="/assets/{{this.id}}" class="text-decoration-none text-primary">
                  {{this.code}}
                </a>
              </td>
              <td class="text-dark fw-semibold">{{this.name}}</td>
              <td>{{this.org_unit_name}}</td>
              <td class="text-end text-dark">{{formatCurrency this.original_cost}}</td>
              <td class="text-end text-dark">
                {{#if (not this.isDone)}}
                  {{formatCurrency this.monthly}}
                {{else}}
                  <span class="text-muted">Đã hết KH</span>
                {{/if}}
              </td>
              <td class="text-end text-success fw-bold">
                {{formatCurrency this.remainingValue}}
                <small class="text-muted fw-normal d-block">Đã trích {{this.percent}}%</small>
              </td>
              <td class="text-end pe-3 text-nowrap">
                <button type="button" class="btn btn-primary text-nowrap" onclick="openScheduleModal({{this.id}})">
                  Xem khấu hao
                </button>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                Không tìm thấy tài sản nào phù hợp.
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Phân trang -->
    {{#if (gt totalPages 1)}}
    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
      <small class="text-muted">Trang {{currentPage}} / {{totalPages}}</small>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          {{#each pages}}
            <li class="page-item {{#if this.active}}active{{/if}}">
              <a class="page-link" href="/depreciation?page={{this.number}}&search={{../search}}&org_unit_id={{../orgUnitId}}">
                {{this.number}}
              </a>
            </li>
          {{/each}}
        </ul>
      </nav>
    </div>
    {{/if}}
  </div>
</div>

<!-- Modal Kế hoạch trích khấu hao -->
<div class="modal fade" id="depreciationScheduleModal" tabindex="-1" aria-labelledby="scheduleModalTitle" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow">
      <div class="modal-header border-bottom py-3">
        <div>
          <h6 class="modal-title fw-bold text-dark mb-0" id="scheduleModalTitle">Kế hoạch trích khấu hao</h6>
          <small class="text-muted" id="scheduleModalSubtitle">Phân bổ khấu hao đường thẳng theo từng kỳ kế toán</small>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
      </div>
      <div class="modal-body p-3">
        <!-- Thẻ tóm tắt thông số -->
        <div id="scheduleAssetInfo"></div>

        <!-- Bảng phân bổ các kỳ -->
        <div class="border rounded table-responsive" style="max-height: 400px; overflow-y: auto;">
          <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light sticky-top">
              <tr>
                <th scope="col" class="ps-3 text-nowrap">Kỳ</th>
                <th scope="col" class="text-nowrap">Kỳ trích (Tháng)</th>
                <th scope="col" class="text-end text-nowrap">Mức trích kỳ này</th>
                <th scope="col" class="text-end text-nowrap">Hao mòn lũy kế</th>
                <th scope="col" class="text-end text-nowrap">Giá trị còn lại</th>
                <th scope="col" class="text-center text-nowrap pe-3">Trạng thái</th>
              </tr>
            </thead>
            <tbody id="scheduleTableBody">
              <tr>
                <td colspan="6" class="text-center py-4 text-muted">Đang tải dữ liệu...</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer border-top py-2 d-flex justify-content-between">
        <a id="btnViewAssetDetail" href="#" target="_blank" class="btn btn-outline-secondary btn-sm">
          Xem hồ sơ tài sản (tab mới)
        </a>
        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Đóng</button>
      </div>
    </div>
  </div>
</div>

<script>
  function formatVnd(val) {
    return new Intl.NumberFormat('vi-VN').format(Math.round(val || 0)) + ' đ';
  }

  async function openScheduleModal(assetId) {
    const modalEl = document.getElementById('depreciationScheduleModal');
    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

    // Reset nội dung đang tải
    document.getElementById('scheduleModalTitle').textContent = 'Kế hoạch trích khấu hao';
    document.getElementById('scheduleModalSubtitle').textContent = 'Đang lấy dữ liệu...';
    document.getElementById('scheduleAssetInfo').innerHTML = '<div class="text-center py-3 text-muted">Đang tải thông tin tài sản...</div>';
    document.getElementById('scheduleTableBody').innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Đang tính toán các kỳ khấu hao...</td></tr>';
    
    modal.show();

    try {
      const res = await fetch(`/depreciation/${assetId}/schedule`);
      const data = await res.json();

      if (!data.success) {
        alert(data.message || 'Không thể lấy thông tin khấu hao của tài sản này.');
        modal.hide();
        return;
      }

      const { asset, dep, schedule } = data;

      document.getElementById('scheduleModalTitle').textContent = `Kế hoạch khấu hao: ${asset.code} - ${asset.name}`;
      document.getElementById('scheduleModalSubtitle').textContent = `Đơn vị: ${asset.org_unit_name} | Danh mục: ${asset.category_name}`;

      const btnAsset = document.getElementById('btnViewAssetDetail');
      if (btnAsset) {
        btnAsset.href = `/assets/${asset.id}`;
      }

      // Đổ dữ liệu tổng hợp
      document.getElementById('scheduleAssetInfo').innerHTML = `
        <div class="row g-2 mb-3">
          <div class="col-6 col-md-3">
            <div class="p-2 border rounded bg-light">
              <small class="text-muted d-block">Nguyên giá</small>
              <div class="fw-bold text-dark mt-1">${formatVnd(asset.original_cost)}</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="p-2 border rounded bg-light">
              <small class="text-muted d-block">Thời gian sử dụng</small>
              <div class="fw-bold text-dark mt-1">${asset.useful_life_months} tháng (${(asset.useful_life_months / 12).toFixed(1)} năm)</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="p-2 border rounded bg-light">
              <small class="text-muted d-block">Đã trích lũy kế</small>
              <div class="fw-bold text-dark mt-1">${formatVnd(dep.accumulated)} (${dep.percent}%)</div>
            </div>
          </div>
          <div class="col-6 col-md-3">
            <div class="p-2 border rounded bg-light">
              <small class="text-muted d-block">Giá trị còn lại</small>
              <div class="fw-bold text-success mt-1">${formatVnd(dep.remainingValue)}</div>
            </div>
          </div>
        </div>
      `;

      // Đổ dữ liệu bảng các kỳ
      if (!schedule || schedule.length === 0) {
        document.getElementById('scheduleTableBody').innerHTML = `
          <tr>
            <td colspan="6" class="text-center py-4 text-muted">
              Tài sản chưa được thiết lập thời gian sử dụng hữu ích.
            </td>
          </tr>
        `;
        return;
      }

      let tbodyHtml = '';
      schedule.forEach((row) => {
        let trClass = '';
        let badgeClass = 'text-bg-light border text-muted';
        if (row.isCurrent) {
          trClass = 'table-primary fw-semibold';
          badgeClass = 'text-bg-primary';
        } else if (row.isPast) {
          badgeClass = 'text-bg-success';
        }

        tbodyHtml += `
          <tr class="${trClass}">
            <td class="ps-3 text-muted">${row.index}</td>
            <td class="font-monospace">${row.period}</td>
            <td class="text-end">${formatVnd(row.amount)}</td>
            <td class="text-end">${formatVnd(row.accumulated)}</td>
            <td class="text-end text-success fw-semibold">${formatVnd(row.remaining)}</td>
            <td class="text-center pe-3">
              <span class="badge ${badgeClass}">${row.statusLabel}</span>
            </td>
          </tr>
        `;
      });

      document.getElementById('scheduleTableBody').innerHTML = tbodyHtml;

      // Cuộn tới kỳ hiện tại
      setTimeout(() => {
        const curRow = document.querySelector('#scheduleTableBody tr.table-primary');
        if (curRow) {
          curRow.scrollIntoView({ block: 'center', behavior: 'smooth' });
        }
      }, 250);

    } catch (err) {
      console.error('Lỗi tải kế hoạch khấu hao:', err);
      alert('Đã xảy ra lỗi khi lấy dữ liệu kế hoạch khấu hao.');
    }
  }
</script>
