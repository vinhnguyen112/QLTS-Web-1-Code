<div class="container-fluid p-0">
  <!-- Thống kê tài chính -->
  <div class="row g-3 mb-3">
    <div class="col-md-4">
      <div class="card p-3 border shadow-none bg-white">
        <small class="text-muted d-block">Tổng nguyên giá tài sản</small>
        <div class="fs-5 fw-bold text-dark mt-1">{{formatCurrency summary.totalCost}}</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3 border shadow-none bg-white">
        <small class="text-muted d-block">Hao mòn lũy kế (Đã trích)</small>
        <div class="fs-5 fw-bold text-danger mt-1">{{formatCurrency summary.totalAccumulated}}</div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card p-3 border shadow-none bg-white">
        <small class="text-muted d-block">Giá trị còn lại hiện tại</small>
        <div class="fs-5 fw-bold text-success mt-1">{{formatCurrency summary.totalRemaining}}</div>
      </div>
    </div>
  </div>

  <!-- Danh sách khấu hao -->
  <div class="card">
    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col-md-5">
          <h5 class="mb-0 fw-bold text-dark">Quản lý Khấu hao Tài sản</h5>
          <small class="text-muted">Theo dõi phân bổ khấu hao đường thẳng và giá trị còn lại toàn hệ thống</small>
        </div>

        <div class="col-md-7 d-flex flex-wrap justify-content-md-end align-items-center gap-2">
          <!-- Tìm kiếm & Lọc -->
          <form action="/depreciation" method="get" class="d-flex align-items-center gap-2 m-0" role="search">
            <div class="input-group input-group-sm" style="width: 250px;">
              <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
              <input
                type="text"
                name="search"
                class="form-control"
                value="{{search}}"
                placeholder="Tìm theo mã, tên tài sản..."
              />
            </div>

            <select name="org_unit_id" class="form-select form-select-sm" style="width: 180px;" onchange="this.form.submit()">
              <option value="">Tất cả đơn vị quản lý</option>
              {{#each orgUnits}}
                <option value="{{this.id}}" {{#if (eq this.id ../orgUnitId)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>

            {{#if (or search orgUnitId)}}
              <a href="/depreciation" class="btn btn-sm btn-secondary text-nowrap">Đặt lại</a>
            {{/if}}
          </form>

          <button type="button" onclick="window.print()" class="btn btn-sm btn-primary text-nowrap">
            <i class="bi bi-printer me-1"></i> In bảng kê
          </button>
        </div>
      </div>
    </div>

    <!-- Bảng danh sách tài sản trích khấu hao -->
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3 text-nowrap">#</th>
            <th scope="col" class="text-nowrap">Mã tài sản</th>
            <th scope="col">Tên tài sản</th>
            <th scope="col">Đơn vị quản lý</th>
            <th scope="col" class="text-end text-nowrap">Nguyên giá</th>
            <th scope="col" class="text-end text-nowrap">Trích / Tháng</th>
            <th scope="col" class="text-end text-nowrap">Giá trị còn lại</th>
            <th scope="col" class="text-end pe-3 text-nowrap">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each assets}}
            <tr>
              <td class="ps-3 text-muted">{{addOne @index}}</td>
              <td class="fw-bold font-monospace">
                <a href="/depreciation/{{this.id}}" class="text-decoration-none text-primary">
                  {{this.code}}
                </a>
              </td>
              <td class="text-dark fw-semibold">{{this.name}}</td>
              <td>{{this.org_unit_name}}</td>
              <td class="text-end text-dark">{{formatCurrency this.original_cost}}</td>
              <td class="text-end text-dark">
                {{#if (not this.isDone)}}
                  {{formatCurrency this.monthly}}
                {{else}}
                  <span class="badge text-bg-light border text-muted">Đã hết KH</span>
                {{/if}}
              </td>
              <td class="text-end text-success fw-bold">
                {{formatCurrency this.remainingValue}}
                <small class="text-muted fw-normal d-block">Đã trích {{this.percent}}%</small>
              </td>
              <td class="text-end pe-3 text-nowrap">
                <a href="/depreciation/{{this.id}}" class="btn btn-sm btn-primary text-nowrap">Chi tiết</a>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                Không tìm thấy tài sản nào phù hợp.
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Phân trang -->
    {{#if (gt totalPages 1)}}
      <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
        <div class="small text-muted">
          Trang <b>{{currentPage}}</b> / {{totalPages}}
        </div>
        <nav aria-label="Phân trang">
          <ul class="pagination pagination-sm mb-0">
            {{#each pages}}
              <li class="page-item {{#if this.active}}active{{/if}}">
                <a class="page-link" href="/depreciation?page={{this.number}}&search={{../search}}&org_unit_id={{../orgUnitId}}">
                  {{this.number}}
                </a>
              </li>
            {{/each}}
          </ul>
        </nav>
      </div>
    {{/if}}
  </div>
</div>
