<div class="container-fluid p-0">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
      <h4 class="mb-1 text-dark fw-bold">Khấu hao tài sản (Phương pháp đường thẳng)</h4>
      <p class="text-muted mb-0 small">Bảng kê phân bổ chi phí khấu hao định kỳ hàng tháng và theo dõi giá trị còn lại theo chuẩn VAS</p>
    </div>
    <div class="d-flex gap-2">
      <button onclick="window.print()" class="btn btn-dark btn-sm">
        In bảng kê khấu hao
      </button>
    </div>
  </div>

  <!-- 4 Thẻ KPI chỉ số tài chính tổng quan -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card border shadow-none h-100">
        <div class="card-body p-3">
          <small class="text-muted d-block fw-semibold text-uppercase">Tổng nguyên giá TSCĐ</small>
          <div class="fs-4 fw-bold text-dark mt-1">{{formatCurrency summary.totalCost}}</div>
          <small class="text-muted">Tổng mức đầu tư ban đầu</small>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border shadow-none h-100">
        <div class="card-body p-3">
          <small class="text-primary d-block fw-semibold text-uppercase">Trích khấu hao tháng này</small>
          <div class="fs-4 fw-bold text-primary mt-1">{{formatCurrency summary.totalMonthly}}</div>
          <small class="text-muted">{{summary.depreciatingCount}} tài sản đang trích</small>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border shadow-none h-100">
        <div class="card-body p-3">
          <small class="text-warning-emphasis d-block fw-semibold text-uppercase">Hao mòn lũy kế</small>
          <div class="fs-4 fw-bold text-warning-emphasis mt-1">{{formatCurrency summary.totalAccumulated}}</div>
          <small class="text-muted">Giá trị đã phân bổ chi phí</small>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-xl-3">
      <div class="card border shadow-none h-100">
        <div class="card-body p-3">
          <small class="text-success d-block fw-semibold text-uppercase">Giá trị còn lại (Book Value)</small>
          <div class="fs-4 fw-bold text-success mt-1">{{formatCurrency summary.totalRemaining}}</div>
          <small class="text-muted">Giá trị tài sản thực tế còn lại</small>
        </div>
      </div>
    </div>
  </div>

  <div class="card border shadow-none">
    <!-- Bộ lọc tìm kiếm và tiêu chí -->
    <div class="card-header bg-white py-3 border-0">
      <form action="/depreciation" method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
          <select name="org_unit_id" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- Tất cả đơn vị / Phòng ban --</option>
            {{#each orgUnits}}
              <option value="{{this.id}}" {{#if (eq this.id ../orgUnitId)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="col-md-3">
          <select name="category_id" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- Tất cả danh mục --</option>
            {{#each categories}}
              <option value="{{this.id}}" {{#if (eq this.id ../categoryId)}}selected{{/if}}>{{this.name}}</option>
            {{/each}}
          </select>
        </div>

        <div class="col-md-2">
          <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">-- Tất cả tình trạng --</option>
            <option value="depreciating" {{#if (eq statusFilter "depreciating")}}selected{{/if}}>Đang trích khấu hao</option>
            <option value="fully_depreciated" {{#if (eq statusFilter "fully_depreciated")}}selected{{/if}}>Đã hết khấu hao</option>
          </select>
        </div>

        <div class="col-md-4 d-flex gap-2">
          <input
            type="text"
            name="search"
            class="form-control form-control-sm"
            value="{{search}}"
            placeholder="Tìm theo mã hoặc tên tài sản..."
          />
          <button class="btn btn-primary btn-sm text-nowrap" type="submit">Lọc</button>
          {{#if (or search (or orgUnitId (or categoryId statusFilter)))}}
            <a href="/depreciation" class="btn btn-secondary btn-sm text-nowrap">Đặt lại</a>
          {{/if}}
        </div>
      </form>
    </div>

    <!-- Bảng danh sách phân bổ khấu hao từng tài sản -->
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th scope="col" class="ps-3 text-nowrap">#</th>
            <th scope="col" class="text-nowrap">Mã tài sản</th>
            <th scope="col">Tên tài sản</th>
            <th scope="col">Đơn vị quản lý</th>
            <th scope="col" class="text-nowrap">Thời hạn</th>
            <th scope="col" class="text-end text-nowrap">Nguyên giá</th>
            <th scope="col" class="text-end text-nowrap">Khấu hao / Tháng</th>
            <th scope="col" class="text-end text-nowrap">Lũy kế đã trích</th>
            <th scope="col" class="text-end text-nowrap">Giá trị còn lại</th>
            <th scope="col" class="text-center text-nowrap">Tiến độ</th>
            <th scope="col" class="text-end pe-3 text-nowrap">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each assets}}
            <tr>
              <td class="ps-3 text-muted">{{addOne @index}}</td>
              <td class="fw-bold font-monospace">
                <a href="/assets/{{this.id}}" class="text-decoration-none text-primary">
                  {{this.code}}
                </a>
              </td>
              <td>
                <div class="fw-semibold text-dark">{{this.name}}</div>
                <small class="text-muted">{{this.category_name}}</small>
              </td>
              <td>{{this.org_unit_name}}</td>
              <td class="text-nowrap">
                {{#if this.useful_life_months}}
                  <div>{{this.useful_life_months}} tháng</div>
                  <small class="text-muted">Đã trích: {{this.used_months}} th</small>
                {{else}}
                  <span class="text-muted small">--</span>
                {{/if}}
              </td>
              <td class="text-end fw-semibold text-dark">{{formatCurrency this.original_cost}}</td>
              <td class="text-end text-primary fw-semibold">
                {{#if (eq this.depreciation_status "depreciating")}}
                  {{formatCurrency this.monthly_amount}}
                {{else}}
                  <span class="text-muted">0 đ</span>
                {{/if}}
              </td>
              <td class="text-end text-warning-emphasis fw-semibold">{{formatCurrency this.accumulated_amount}}</td>
              <td class="text-end text-success fw-bold">{{formatCurrency this.remaining_value}}</td>
              <td class="text-center text-nowrap">
                <div class="d-flex align-items-center justify-content-center gap-2">
                  <div class="progress flex-grow-1" style="height: 6px; min-width: 60px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: {{this.depreciation_percent}}%;"></div>
                  </div>
                  <span class="small fw-semibold">{{this.depreciation_percent}}%</span>
                </div>
                <div class="mt-1">{{{this.status_badge}}}</div>
              </td>
              <td class="text-end pe-3 text-nowrap">
                <div class="d-inline-flex gap-1">
                  <a href="/assets/{{this.id}}" class="btn btn-primary text-nowrap">Chi tiết</a>
                </div>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="11" class="text-center py-5 text-muted">
                Không tìm thấy tài sản nào phù hợp với điều kiện lọc.
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- Phân trang -->
    {{#if (gt totalPages 1)}}
    <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between align-items-center">
      <small class="text-muted">Trang {{currentPage}} / {{totalPages}} (Tổng số {{totalItems}} tài sản)</small>
      <nav>
        <ul class="pagination pagination-sm mb-0">
          {{#each pages}}
            <li class="page-item {{#if this.active}}active{{/if}}">
              <a class="page-link" href="/depreciation?page={{this.number}}&search={{../search}}&org_unit_id={{../orgUnitId}}&category_id={{../categoryId}}&status={{../statusFilter}}">
                {{this.number}}
              </a>
            </li>
          {{/each}}
        </ul>
      </nav>
    </div>
    {{/if}}
  </div>
</div>
