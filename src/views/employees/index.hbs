<div class="container-fluid">
  <div class="card">

    <div class="card-header bg-white py-3">
      <div class="row align-items-center g-2">
        <div class="col">
          <h5 class="mb-0">Nhân sự</h5>
          <small class="text-muted">Quản lý nhân sự sử dụng tài sản trong hệ thống</small>
        </div>

        <div class="col-auto d-flex align-items-center gap-2">
          <form action="" method="get" class="m-0" role="search">
            <div class="input-group">
              <input
                type="text"
                name="name"
                class="form-control"
                value="{{searchName}}"
                placeholder="Tìm nhân sự..."
              />
              <button class="btn btn-secondary" type="submit">Lọc</button>
            </div>
          </form>
          <button
            type="button"
            class="btn btn-primary"
            data-bs-toggle="modal"
            data-bs-target="#addEmployeeModal"
          >Thêm nhân sự</button>
        </div>
      </div>
    </div>

    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>STT</th>
            <th>Mã nhân sự</th>
            <th>Họ và tên</th>
            <th>Phòng ban</th>
            <th>Chức vụ</th>
            <th>Số tài sản</th>
            <th class="text-center">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          {{#each employees}}
            <tr>
              <td>{{addOne @index}}</td>
              <td>{{this.employee_code}}</td>
              <td>{{this.full_name}}</td>
              <td>{{this.department_name}}</td>
              <td>{{this.position}}</td>
              <td>{{this.asset_count}}</td>
              <td>
                <div class="d-flex justify-content-center gap-1">
                  <a href="/employees/{{this.employee_id}}/edit" class="btn btn-sm btn-warning">Sửa</a>
                  <form
                    action="/employees/{{this.employee_id}}/delete"
                    method="POST"
                    class="m-0"
                    onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhân sự này không?');"
                  >
                    <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                  </form>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

  </div>
</div>

<!-- Modal thêm nhân sự -->
<div class="modal fade" id="addEmployeeModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      {{> employees-create}}
    </div>
  </div>
</div>