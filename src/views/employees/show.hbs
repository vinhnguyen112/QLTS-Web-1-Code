<div class="container-fluid">
    <div class="mb-4">
        <h3 class="mb-1">Chi tiết nhân sự</h3>
        <p class="text-secondary mb-0">
            Thông tin chi tiết của nhân sự
        </p>
    </div>

    <div class="card">
        <div class="card-header">
            Thông tin nhân sự
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <strong>Mã nhân sự:</strong>
                    <div>{{employee.employee_code}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Họ và tên:</strong>
                    <div>{{employee.full_name}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Phòng ban:</strong>
                    <div>{{#if employee.department_name}}{{employee.department_name}}{{else}}<span class="text-muted">Chưa phân phòng ban</span>{{/if}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Chức vụ:</strong>
                    <div>{{#if employee.position}}{{employee.position}}{{else}}<span class="text-muted">Chưa cập nhật</span>{{/if}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Số điện thoại:</strong>
                    <div>{{#if employee.phone}}{{employee.phone}}{{else}}<span class="text-muted">Chưa cập nhật</span>{{/if}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Email:</strong>
                    <div>{{#if employee.email}}{{employee.email}}{{else}}<span class="text-muted">Chưa cập nhật</span>{{/if}}</div>
                </div>
                <div class="col-md-6 mb-3">
                    <strong>Số tài sản đang giữ:</strong>
                    <div>{{employee.asset_count}}</div>
                </div>
            </div>
            <div class="mt-3">
                <a href="/employees"
                   class="btn btn-secondary">
                    Quay lại
                </a>
                <a href="/employees/{{employee.employee_id}}/edit"
                   class="btn btn-warning">
                    Sửa nhân sự
                </a>
            </div>
        </div>
    </div>
</div>
