<div class="container-fluid">
  <div class="mb-4">
    <h3 class="mb-1">Sửa nhân sự</h3>
    <p class="text-secondary mb-0">
      Cập nhật thông tin nhân sự
    </p>
  </div>

  <div class="card">
    <div class="card-body">
      <form action="/employees/{{employee.employee_id}}/update" method="POST">
        <div class="row">
          <!-- Mã nhân sự -->
          <div class="col-md-6 mb-3">
            <label for="employee_code" class="form-label">
              Mã nhân sự
              <span class="text-danger">*</span>
            </label>

            <input
              type="text"
              class="form-control"
              id="employee_code"
              name="employee_code"
              value="{{employee.employee_code}}"
              required
            />
          </div>

          <!-- Họ tên -->
          <div class="col-md-6 mb-3">
            <label for="full_name" class="form-label">
              Họ và tên
              <span class="text-danger">*</span>
            </label>

            <input
              type="text"
              class="form-control"
              id="full_name"
              name="full_name"
              value="{{employee.full_name}}"
              required
            />
          </div>

          <!-- Chức vụ -->
          <div class="col-md-6 mb-3">
            <label for="position" class="form-label">
              Chức vụ
            </label>

            <input
              type="text"
              class="form-control"
              id="position"
              name="position"
              value="{{employee.position}}"
            />
          </div>

          <!-- Số điện thoại -->
          <div class="col-md-6 mb-3">
            <label for="phone" class="form-label">
              Số điện thoại
            </label>

            <input
              type="text"
              class="form-control"
              id="phone"
              name="phone"
              value="{{employee.phone}}"
            />
          </div>

          <!-- Email -->
          <div class="col-md-6 mb-3">
            <label for="email" class="form-label">
              Email
            </label>

            <input
              type="email"
              class="form-control"
              id="email"
              name="email"
              value="{{employee.email}}"
            />
          </div>
        </div>

        <div class="mt-3">
          <a href="/employees" class="btn btn-secondary">
            Quay lại
          </a>
          <button type="submit" class="btn btn-primary">
            Lưu thay đổi
          </button>
        </div>
      </form>
    </div>
  </div>
</div>