<div class="container-fluid p-0" style="max-width: 750px; margin: auto;">
  <div class="card border shadow-none">
    <div class="card-header bg-white py-3 border-0 d-flex justify-content-between align-items-center">
      <div>
        <h5 class="mb-0 fw-bold text-dark">Sửa người dùng: {{employee.full_name}}</h5>
        <small class="text-muted">Tài khoản: @{{employee.username}}</small>
      </div>
      <a href="/employees" class="btn btn-secondary btn-sm">Quay lại</a>
    </div>

    <form action="/employees/{{employee.id}}/update" method="POST">
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label small fw-semibold">Họ và tên <span class="text-danger">*</span></label>
            <input type="text" class="form-control" name="full_name" value="{{employee.full_name}}" required />
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-semibold">Email <span class="text-danger">*</span></label>
            <input type="email" class="form-control" name="email" value="{{employee.email}}" required />
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-semibold">Phòng ban</label>
            <select class="form-select" name="org_unit_id">
              {{#each formData.departments}}
                <option value="{{this.id}}" {{#if (eq this.id ../employee.org_unit_id)}}selected{{/if}}>{{this.name}}</option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-semibold">Vai trò hệ thống</label>
            <select class="form-select" name="role_id">
              {{#each formData.roles}}
                <option value="{{this.id}}" {{#if (eq this.id ../employee.role_id)}}selected{{/if}}>{{this.name}} ({{this.code}})</option>
              {{/each}}
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label small fw-semibold">Trạng thái tài khoản</label>
            <select class="form-select" name="status">
              <option value="ACTIVE" {{#if (eq employee.status "ACTIVE")}}selected{{/if}}>Đang hoạt động (ACTIVE)</option>
              <option value="LOCKED" {{#if (eq employee.status "LOCKED")}}selected{{/if}}>Đang bị khóa (LOCKED)</option>
              <option value="INACTIVE" {{#if (eq employee.status "INACTIVE")}}selected{{/if}}>Ngừng sử dụng (INACTIVE)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="card-footer bg-white border-top d-flex justify-content-end gap-2 py-3">
        <a href="/employees" class="btn btn-secondary btn-sm px-3">Hủy</a>
        <button type="submit" class="btn btn-primary btn-sm px-4 fw-semibold">Lưu thay đổi</button>
      </div>
    </form>
  </div>
</div>
